<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%List<Map<String,Object>> notifications=(List<Map<String,Object>>)request.getAttribute("notifications");String role=((com.erp.model.User)session.getAttribute("user")).getRole().name().toLowerCase();%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="min-h-screen bg-slate-100 text-slate-800"><main class="mx-auto max-w-3xl p-4 sm:p-8"><a href="<%=request.getContextPath()%>/<%=role%>/dashboard" class="text-sm font-semibold text-indigo-700"><i class="fa-solid fa-arrow-left mr-2"></i>Back to dashboard</a><div class="mb-6 mt-5 flex items-end justify-between"><div><h1 class="text-3xl font-bold">Notifications</h1><p class="mt-1 text-sm text-slate-500">Updates related to your classes and academic work.</p></div><span class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700"><%=request.getAttribute("unreadCount")%> unread</span></div><%if(request.getAttribute("loadError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><section class="divide-y divide-slate-100 overflow-hidden rounded-xl bg-white shadow-sm"><%if(notifications!=null)for(Map<String,Object> n:notifications){boolean unread=n.get("read_at")==null;%><a href="<%=request.getContextPath()%>/notifications?action=open&amp;id=<%=n.get("id")%>" class="block p-5 hover:bg-slate-50 <%=unread?"bg-indigo-50/40":""%>"><div class="flex gap-3"><span class="mt-1 text-indigo-600"><i class="fa-solid <%=unread?"fa-circle":"fa-bell"%>"></i></span><div class="min-w-0 flex-1"><div class="flex items-start justify-between gap-3"><h2 class="font-semibold"><%=HtmlUtil.escape(n.get("title"))%></h2><time class="shrink-0 text-xs text-slate-400"><%=HtmlUtil.escape(n.get("created_at"))%></time></div><p class="mt-1 text-sm text-slate-600"><%=HtmlUtil.escape(n.get("message"))%></p></div></div></a><%}%><%if(notifications==null||notifications.isEmpty()){%><p class="p-10 text-center text-sm text-slate-500">Your inbox is clear. New updates will appear here.</p><%}%></section></main></body></html>
