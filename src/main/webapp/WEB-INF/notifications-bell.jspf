<%@ page import="com.erp.dao.NotificationDAO,com.erp.model.User,com.erp.util.HtmlUtil,java.util.List,java.util.Map" %><%User notificationUser=(User)session.getAttribute("user");int notificationUnread=0;List<Map<String,Object>> notificationRecent=java.util.Collections.emptyList();if(notificationUser!=null)try{NotificationDAO notificationDao=new NotificationDAO();notificationUnread=notificationDao.unreadCount(notificationUser.getId());notificationRecent=notificationDao.recent(notificationUser.getId());}catch(Exception e){application.log("Notification preview could not be loaded",e);}%><details class="group relative"><summary class="relative flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50" aria-label="Notifications<%=notificationUnread>0?", "+notificationUnread+" unread":""%>"><i class="fa-solid fa-bell"></i><%if(notificationUnread>0){%><span class="absolute -right-1 -top-1 min-w-5 rounded-full bg-rose-600 px-1 text-center text-[10px] font-bold leading-5 text-white"><%=notificationUnread>99?"99+":notificationUnread%></span><%}%></summary><div class="absolute right-0 top-full z-50 mt-2 w-[min(22rem,calc(100vw-2rem))] overflow-hidden rounded-xl border border-slate-200 bg-white text-left shadow-xl"><div class="flex items-center justify-between border-b border-slate-100 px-4 py-3"><div><p class="font-semibold text-slate-800">Notifications</p><p class="text-xs text-slate-500"><%=notificationUnread%> unread</p></div><i class="fa-regular fa-bell text-slate-400"></i></div><div class="max-h-96 divide-y divide-slate-100 overflow-y-auto"><%int notificationShown=0;for(Map<String,Object> notification:notificationRecent){if(notificationShown++>=5)break;boolean notificationIsUnread=notification.get("read_at")==null;%><a href="<%=request.getContextPath()%>/notifications?action=open&amp;id=<%=notification.get("id")%>" class="block px-4 py-3 hover:bg-slate-50 <%=notificationIsUnread?"bg-indigo-50/40":""%>"><div class="flex items-start gap-3"><span class="mt-1 text-indigo-600"><i class="fa-solid <%=notificationIsUnread?"fa-circle":"fa-bell"%>"></i></span><div class="min-w-0"><p class="truncate text-sm font-semibold text-slate-800"><%=HtmlUtil.escape(notification.get("title"))%></p><p class="mt-0.5 line-clamp-2 text-xs text-slate-600"><%=HtmlUtil.escape(notification.get("message"))%></p><p class="mt-1 text-[11px] text-slate-400"><%=HtmlUtil.escape(notification.get("created_at"))%></p></div></div></a><%}%><%if(notificationRecent.isEmpty()){%><p class="px-4 py-8 text-center text-sm text-slate-500">Your inbox is clear.</p><%}%></div><a href="<%=request.getContextPath()%>/notifications" class="block border-t border-slate-100 bg-slate-50 px-4 py-3 text-center text-sm font-semibold text-indigo-700 hover:bg-indigo-50">View all notifications</a></div></details>
