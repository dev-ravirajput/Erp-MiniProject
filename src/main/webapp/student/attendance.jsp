<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("studentProfile")==null){response.sendRedirect(request.getContextPath()+"/student/attendance");return;}request.setAttribute("studentPage","attendance");List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("attendance");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Attendance</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="student-nav.jspf"%><section class="p-4 sm:p-8"><h2 class="text-2xl font-bold">Attendance</h2><p class="mb-6 mt-1 text-sm text-slate-500">Your recorded attendance by subject and date.</p><%if(request.getAttribute("loadError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><div class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">Date</th><th class="px-5 py-3">Subject</th><th class="px-5 py-3">Class</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Remarks</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object> row:rows){%><tr class="border-t"><td class="px-5 py-3"><%=HtmlUtil.escape(row.get("attendance_date"))%></td><td class="px-5 py-3"><%=HtmlUtil.escape(row.get("subject_name"))%></td><td class="px-5 py-3"><%=HtmlUtil.escape(row.get("class_name"))%> · <%=HtmlUtil.escape(row.get("section_name"))%></td><td class="px-5 py-3"><span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700"><%=HtmlUtil.escape(row.get("status"))%></span></td><td class="px-5 py-3 text-slate-500"><%=HtmlUtil.escape(row.get("remarks")==null?"—":row.get("remarks"))%></td></tr><%}%><%if(rows==null||rows.isEmpty()){%><tr><td colspan="5" class="px-5 py-10 text-center text-slate-500">No attendance has been recorded yet.</td></tr><%}%></tbody></table></div></section></main></div></body></html>
