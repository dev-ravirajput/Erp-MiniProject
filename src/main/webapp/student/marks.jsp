<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("studentProfile")==null){response.sendRedirect(request.getContextPath()+"/student/marks");return;}request.setAttribute("studentPage","marks");List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("marks");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Marks</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="student-nav.jspf"%><section class="p-4 sm:p-8"><h2 class="text-2xl font-bold">Marks</h2><p class="mb-6 mt-1 text-sm text-slate-500">Subject marks published for your exams.</p><%if(request.getAttribute("loadError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><div class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">Exam</th><th class="px-5 py-3">Date</th><th class="px-5 py-3">Subject</th><th class="px-5 py-3">Marks</th><th class="px-5 py-3">Grade</th><th class="px-5 py-3">Remarks</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object> row:rows){%><tr class="border-t"><td class="px-5 py-3 font-medium"><%=HtmlUtil.escape(row.get("exam_name"))%><div class="text-xs text-slate-400"><%=HtmlUtil.escape(row.get("academic_year"))%></div></td><td class="px-5 py-3"><%=HtmlUtil.escape(row.get("exam_date"))%></td><td class="px-5 py-3"><%=HtmlUtil.escape(row.get("subject_name"))%></td><td class="px-5 py-3 font-semibold"><%=HtmlUtil.escape(row.get("marks"))%> / <%=HtmlUtil.escape(row.get("max_marks"))%></td><td class="px-5 py-3 font-bold"><%=HtmlUtil.escape(row.get("grade"))%></td><td class="px-5 py-3 text-slate-500"><%=HtmlUtil.escape(row.get("remarks")==null?"—":row.get("remarks"))%></td></tr><%}%><%if(rows==null||rows.isEmpty()){%><tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No marks have been published yet.</td></tr><%}%></tbody></table></div><p class="mt-3 text-xs text-slate-400">Marks are read-only. Contact your teacher if you have a question about a result.</p></section></main></div></body></html>
