<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,java.util.LinkedHashMap,java.math.BigDecimal,com.erp.util.HtmlUtil" %><%
if(request.getAttribute("studentProfile")==null){response.sendRedirect(request.getContextPath()+"/student/result");return;}request.setAttribute("studentPage","result");List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("marks");Map<String,BigDecimal[]> totals=new LinkedHashMap<>();if(rows!=null)for(Map<String,Object> r:rows){String exam=String.valueOf(r.get("exam_name"))+" ("+r.get("academic_year")+")";BigDecimal[] pair=totals.computeIfAbsent(exam,k->new BigDecimal[]{BigDecimal.ZERO,BigDecimal.ZERO});pair[0]=pair[0].add(new BigDecimal(String.valueOf(r.get("marks"))));pair[1]=pair[1].add(new BigDecimal(String.valueOf(r.get("max_marks"))));}%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Result transcript</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><style>@media print{aside,header,.print-hidden{display:none!important}main{margin:0!important}.print-area{box-shadow:none!important;border:0!important}}</style></head>
<body class="bg-slate-100 text-slate-800"><%@include file="student-nav.jspf"%><section class="space-y-5 p-4 sm:p-8"><div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-2xl font-bold">Result transcript</h2><p class="mt-1 text-sm text-slate-500">Published exam totals, subject grades, and remarks.</p></div><button onclick="window.print()" class="print-hidden rounded-md bg-indigo-700 px-4 py-2 font-semibold text-white">Print transcript</button></div>
<%if(request.getAttribute("loadError")!=null){%><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%>
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3"><%for(Map.Entry<String,BigDecimal[]> entry:totals.entrySet()){BigDecimal[] value=entry.getValue();BigDecimal pct=value[1].signum()==0?BigDecimal.ZERO:value[0].multiply(BigDecimal.valueOf(100)).divide(value[1],1,java.math.RoundingMode.HALF_UP);%><article class="rounded-xl bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">Exam</p><h3 class="mt-1 text-lg font-bold"><%=HtmlUtil.escape(entry.getKey())%></h3><p class="mt-5 text-3xl font-bold text-indigo-700"><%=pct.toPlainString()%>%</p><p class="mt-1 text-sm text-slate-500"><%=value[0].stripTrailingZeros().toPlainString()%> out of <%=value[1].stripTrailingZeros().toPlainString()%> marks</p></article><%}%><%if(totals.isEmpty()){%><div class="rounded-xl bg-white p-8 text-center text-slate-500 md:col-span-2 xl:col-span-3">Results will appear when marks are published.</div><%}%></div>
<div class="print-area overflow-x-auto rounded-xl bg-white shadow-sm"><div class="border-b px-5 py-4"><h3 class="font-bold">Subject results</h3><p class="text-xs text-slate-500"><%=HtmlUtil.escape(((Map<String,Object>)request.getAttribute("studentProfile")).get("name"))%></p></div><table class="w-full min-w-[720px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Exam / year</th><th class="px-4 py-3">Date</th><th class="px-4 py-3">Subject</th><th class="px-4 py-3">Score</th><th class="px-4 py-3">Grade</th><th class="px-4 py-3">Remarks</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object> row:rows){%><tr class="border-t"><td class="px-4 py-3"><%=HtmlUtil.escape(row.get("exam_name"))%> · <%=HtmlUtil.escape(row.get("academic_year"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(row.get("exam_date"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(row.get("subject_name"))%></td><td class="px-4 py-3 font-semibold"><%=HtmlUtil.escape(row.get("marks"))%> / <%=HtmlUtil.escape(row.get("max_marks"))%></td><td class="px-4 py-3 font-bold"><%=HtmlUtil.escape(row.get("grade"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(row.get("remarks"))%></td></tr><%}%><%if(rows==null||rows.isEmpty()){%><tr><td colspan="6" class="p-8 text-center text-slate-500">No published results are available.</td></tr><%}%></tbody></table></div>
</section></main></div></body></html>
