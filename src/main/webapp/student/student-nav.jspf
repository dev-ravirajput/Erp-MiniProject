<%@ page import="java.util.Map,java.sql.SQLException,com.erp.dao.AppSettingsDAO,com.erp.util.HtmlUtil" %><%
Map<String,String> studentBrand=new java.util.HashMap<>();studentBrand.put("site_name","EduERP");try{studentBrand.putAll(new AppSettingsDAO().getSettings());}catch(Exception | LinkageError e){application.log("Student portal branding could not be loaded; using defaults",e);}String brand=studentBrand.getOrDefault("site_name","EduERP"),brandLogo=studentBrand.get("logo_url"),brandIcon=studentBrand.get("favicon_url");if(brandLogo!=null&&brandLogo.startsWith("/"))brandLogo=request.getContextPath()+brandLogo;if(brandIcon!=null&&brandIcon.startsWith("/"))brandIcon=request.getContextPath()+brandIcon;String activePage=(String)request.getAttribute("studentPage");String studentName=String.valueOf(((Map<String,Object>)request.getAttribute("studentProfile")).get("name"));
%><%if(brandIcon!=null&&!brandIcon.isBlank()){%><span id="student-brand-icon" class="hidden" data-icon="<%=HtmlUtil.escape(brandIcon)%>"></span><script>(function(){const b=document.getElementById('student-brand-icon');let n=document.querySelector('link[rel~="icon"]');if(!n){n=document.createElement('link');n.rel='icon';document.head.appendChild(n);}n.href=b.dataset.icon;})();</script><%}%><div class="min-h-screen lg:flex"><aside class="bg-slate-900 text-white lg:fixed lg:inset-y-0 lg:w-64"><div class="flex h-20 items-center gap-3 border-b border-slate-700 px-5"><%if(brandLogo!=null&&!brandLogo.isBlank()){%><img src="<%=HtmlUtil.escape(brandLogo)%>" alt="" class="h-10 w-10 rounded-lg bg-white object-contain"><%}else{%><span class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600 font-bold"><%=HtmlUtil.escape(brand.substring(0,1).toUpperCase())%></span><%}%><div><p class="font-bold"><%=HtmlUtil.escape(brand)%></p><p class="text-xs text-slate-400">Student Portal</p></div></div><nav class="space-y-1 p-3 text-sm"><%String[][] links={{"dashboard","Dashboard","fa-gauge-high"},{"profile","My profile","fa-user"},{"attendance","Attendance","fa-calendar-check"},{"assignments","Assignments","fa-book-open"},{"marks","Marks","fa-file-lines"},{"result","Result","fa-chart-column"},{"fees","Fees","fa-receipt"}};for(String[] link:links){String selected=link[0].equals(activePage)?"bg-indigo-700 text-white":"text-slate-300 hover:bg-slate-800";%><a href="<%=request.getContextPath()%>/student/<%=link[0]%>" class="block rounded-lg px-3 py-2.5 <%=selected%>"><i class="fa-solid <%=link[2]%> mr-3 w-4"></i><%=link[1]%></a><%}%></nav><div class="border-t border-slate-700 p-4"><p class="truncate text-sm font-medium"><%=HtmlUtil.escape(studentName)%></p><form action="<%=request.getContextPath()%>/logout" method="post"><button class="mt-3 w-full rounded-lg border border-slate-600 px-3 py-2 text-left text-sm hover:bg-slate-800"><i class="fa-solid fa-right-from-bracket mr-2"></i>Sign out</button></form></div></aside><main class="min-w-0 flex-1 lg:ml-64"><header class="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-5 sm:px-8"><span class="font-semibold text-slate-700"><%=HtmlUtil.escape(activePage==null?"Dashboard":activePage.substring(0,1).toUpperCase()+activePage.substring(1))%></span><div class="flex items-center gap-3"><span class="text-sm text-slate-500"><%=HtmlUtil.escape(studentName)%></span><%@ include file="/WEB-INF/notifications-bell.jspf" %></div></header>
