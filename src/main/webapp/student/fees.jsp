<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("studentProfile")==null){response.sendRedirect(request.getContextPath()+"/student/fees");return;}request.setAttribute("studentPage","fees");List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("invoices");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Fees</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="student-nav.jspf"%><section class="space-y-4 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">Fees</h2><p class="mt-1 text-sm text-slate-500">Invoice balances and payment status. Contact the office to make a payment.</p></div><div class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Invoice</th><th class="px-4 py-3">Year</th><th class="px-4 py-3">Due</th><th class="px-4 py-3">Amount</th><th class="px-4 py-3">Concession</th><th class="px-4 py-3">Paid</th><th class="px-4 py-3">Balance</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object> i:rows){%><tr class="border-t"><td class="px-4 py-3 font-semibold"><%=HtmlUtil.escape(i.get("title"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("academic_year"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("due_date"))%><%if(i.get("overdue") instanceof Number&&((Number)i.get("overdue")).intValue()==1){%><div class="text-xs font-semibold text-rose-700">Overdue</div><%}%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("amount"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("concession_amount"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("paid_amount"))%></td><td class="px-4 py-3 font-semibold"><%=HtmlUtil.escape(i.get("balance"))%></td></tr><%}%><%if(rows==null||rows.isEmpty()){%><tr><td colspan="7" class="p-8 text-center text-slate-500">No invoices are available.</td></tr><%}%></tbody></table></div></section></main></div></body></html>
