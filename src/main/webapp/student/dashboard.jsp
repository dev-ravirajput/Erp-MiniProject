<%@ page contentType="text/html;charset=UTF-8" %><% if(request.getAttribute("studentProfile")==null){response.sendRedirect(request.getContextPath()+"/student/dashboard");return;} %>
<%@ page import="java.util.Map,java.util.List,com.erp.util.HtmlUtil" %><% Map<String,Object> student=(Map<String,Object>)request.getAttribute("studentProfile");List<Map<String,Object>> attendance=(List<Map<String,Object>>)request.getAttribute("attendance"), assignments=(List<Map<String,Object>>)request.getAttribute("assignments"), marks=(List<Map<String,Object>>)request.getAttribute("marks");int total=(Integer)request.getAttribute("attendanceTotal");long present=(Long)request.getAttribute("attendancePresent");String name=String.valueOf(student.get("name"));String initials=name.isEmpty()?"S":name.substring(0,1).toUpperCase(); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student Dashboard</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@ include file="student-nav.jspf" %>
<section class="space-y-6 p-4 sm:p-6 lg:p-8"><% if(request.getAttribute("loadError")!=null){ %><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><% } %>
<div class="flex flex-wrap items-center justify-between gap-4"><div><p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">Student portal</p><h2 class="mt-1 text-3xl font-bold text-slate-900">Welcome, <%=HtmlUtil.escape(name)%></h2><p class="mt-2 text-slate-500">Here’s your academic overview.</p></div><div class="flex h-14 w-14 items-center justify-center rounded-full bg-indigo-100 text-xl font-bold text-indigo-700"><%=HtmlUtil.escape(initials)%></div></div>
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><div class="rounded-xl bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">My class</p><p class="mt-2 text-xl font-bold"><%=HtmlUtil.escape(student.get("class_name")==null?"Not assigned":student.get("class_name"))%><%if(student.get("section_name")!=null){%> · <%=HtmlUtil.escape(student.get("section_name"))%><%}%></p><p class="mt-1 text-xs text-slate-400"><%=HtmlUtil.escape(student.get("academic_year")==null?"":student.get("academic_year"))%></p></div><div class="rounded-xl bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">Attendance</p><p class="mt-2 text-2xl font-bold"><%=total==0?"—":Math.round((double)present*100/total)+"%"%></p><p class="mt-1 text-xs text-slate-400"><%=present%> present or late out of <%=total%> records</p></div><div class="rounded-xl bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">Assignments</p><p class="mt-2 text-2xl font-bold"><%=assignments.size()%></p><p class="mt-1 text-xs text-slate-400">Upcoming and recent</p></div><div class="rounded-xl bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">Published marks</p><p class="mt-2 text-2xl font-bold"><%=marks.size()%></p><p class="mt-1 text-xs text-slate-400">Recent results</p></div></div>
<div class="grid gap-6 xl:grid-cols-2"><section class="rounded-xl bg-white p-5 shadow-sm"><div class="mb-4 flex items-center justify-between"><h3 class="font-bold">Recent attendance</h3><a class="text-sm font-semibold text-indigo-700" href="<%=request.getContextPath()%>/student/attendance">View all</a></div><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="text-xs uppercase text-slate-400"><tr><th class="py-2">Date</th><th>Subject</th><th>Status</th></tr></thead><tbody><%for(Map<String,Object> row:attendance){%><tr class="border-t"><td class="py-3"><%=HtmlUtil.escape(row.get("attendance_date"))%></td><td><%=HtmlUtil.escape(row.get("subject_name"))%></td><td><%=HtmlUtil.escape(row.get("status"))%></td></tr><%}%><%if(attendance.isEmpty()){%><tr><td colspan="3" class="py-5 text-slate-500">No attendance records yet.</td></tr><%}%></tbody></table></div></section><section class="rounded-xl bg-white p-5 shadow-sm"><div class="mb-4 flex items-center justify-between"><h3 class="font-bold">Assignments</h3><a class="text-sm font-semibold text-indigo-700" href="<%=request.getContextPath()%>/student/assignments">View all</a></div><div class="space-y-3"><%for(Map<String,Object> row:assignments){%><article class="rounded-lg border border-slate-100 p-3"><div class="flex justify-between gap-3"><h4 class="font-semibold"><%=HtmlUtil.escape(row.get("title"))%></h4><span class="whitespace-nowrap text-xs text-slate-500">Due <%=HtmlUtil.escape(row.get("due_date"))%></span></div><p class="mt-1 text-sm text-slate-500"><%=HtmlUtil.escape(row.get("subject_name"))%> · <%=HtmlUtil.escape(row.get("teacher_name"))%></p></article><%}%><%if(assignments.isEmpty()){%><p class="py-4 text-sm text-slate-500">No assignments available.</p><%}%></div></section></div></section></main></div></body></html>
