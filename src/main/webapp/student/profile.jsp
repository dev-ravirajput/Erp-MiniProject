<%@ page contentType="text/html;charset=UTF-8" import="java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("studentProfile")==null){response.sendRedirect(request.getContextPath()+"/student/profile");return;}Map<String,Object> student=(Map<String,Object>)request.getAttribute("studentProfile");request.setAttribute("studentPage","profile"); %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Profile</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="student-nav.jspf"%><section class="p-4 sm:p-8"><%if(request.getAttribute("loadError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><div class="mb-6"><h2 class="text-2xl font-bold">My profile</h2><p class="mt-1 text-sm text-slate-500">Your personal and enrollment information.</p></div><div class="grid gap-5 lg:grid-cols-2"><section class="rounded-xl bg-white p-6 shadow-sm"><h3 class="mb-4 font-bold">Personal details</h3><dl class="grid grid-cols-1 gap-4 sm:grid-cols-2"><%String[][] fields={{"Full name","name"},{"Email","email"},{"Admission number","admission_no"},{"Roll number","roll_no"},{"Phone","phone"},{"Date of birth","dob"},{"Gender","gender"},{"Admission date","admission_date"}};for(String[] f:fields){Object v=student.get(f[1]);%><div><dt class="text-xs font-semibold uppercase text-slate-400"><%=f[0]%></dt><dd class="mt-1"><%=HtmlUtil.escape(v==null||v.toString().isBlank()?"Not provided":v)%></dd></div><%}%></dl><div class="mt-4"><dt class="text-xs font-semibold uppercase text-slate-400">Address</dt><dd class="mt-1"><%=HtmlUtil.escape(student.get("address")==null||student.get("address").toString().isBlank()?"Not provided":student.get("address"))%></dd></div></section><section class="rounded-xl bg-white p-6 shadow-sm"><h3 class="mb-4 font-bold">Current enrollment</h3><dl class="space-y-4"><div><dt class="text-xs font-semibold uppercase text-slate-400">Class</dt><dd class="mt-1"><%=HtmlUtil.escape(student.get("class_name")==null?"Not assigned":student.get("class_name"))%></dd></div><div><dt class="text-xs font-semibold uppercase text-slate-400">Section</dt><dd class="mt-1"><%=HtmlUtil.escape(student.get("section_name")==null?"Not assigned":student.get("section_name"))%></dd></div><div><dt class="text-xs font-semibold uppercase text-slate-400">Academic year</dt><dd class="mt-1"><%=HtmlUtil.escape(student.get("academic_year")==null?"Not assigned":student.get("academic_year"))%></dd></div></dl></section></div></section></main></div></body></html>
