<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.Map,java.util.List,com.erp.util.HtmlUtil,com.erp.model.User" %><%
boolean editing="update".equals(request.getAttribute("mode"));Map<String,?> schedule=(Map<String,?>)request.getAttribute("schedule");List<Map<String,Object>> sections=(List<Map<String,Object>>)request.getAttribute("sectionOptions"),subjects=(List<Map<String,Object>>)request.getAttribute("subjectOptions");String pageTitle=editing?"Edit exam schedule":"Add exam date";User sessionUser=(User)session.getAttribute("user");String adminDisplayName=sessionUser!=null&&sessionUser.getName()!=null?sessionUser.getName():"Administrator";String initial=adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();String start=schedule.get("start_time")==null?"":String.valueOf(schedule.get("start_time")),end=schedule.get("end_time")==null?"":String.valueOf(schedule.get("end_time"));if(start.length()>5)start=start.substring(0,5);if(end.length()>5)end=end.substring(0,5);%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=HtmlUtil.escape(pageTitle)%> | EduERP</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 font-sans text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="p-4 sm:p-6 lg:p-8"><div class="mb-5"><h2 class="text-2xl font-bold"><%=HtmlUtil.escape(pageTitle)%></h2><p class="mt-1 text-sm text-slate-500">Set an exam period for one subject and class section.</p></div>
<%if(request.getAttribute("formError")!=null){%><div class="mb-5 max-w-3xl border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-800"><%=HtmlUtil.escape(request.getAttribute("formError"))%></div><%}%>
<form method="post" action="<%=request.getContextPath()%>/admin/examinations" class="max-w-3xl border border-slate-200 bg-white shadow-sm"><input type="hidden" name="action" value="<%=editing?"update":"create"%>"><%if(editing){%><input type="hidden" name="id" value="<%=HtmlUtil.escape(schedule.get("id"))%>"><%}%><div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-7">
<div class="sm:col-span-2"><label for="exam_name" class="mb-1 block text-sm font-semibold">Examination name *</label><input id="exam_name" name="exam_name" required maxlength="100" placeholder="Mid-term examination" value="<%=HtmlUtil.escape(schedule.get("exam_name"))%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"></div>
<div><label for="section_id" class="mb-1 block text-sm font-semibold">Class / section *</label><select id="section_id" name="section_id" required class="w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="">Choose a section</option><%if(sections!=null)for(Map<String,Object>s:sections){String sid=String.valueOf(s.get("id"));%><option value="<%=sid%>" data-year="<%=HtmlUtil.escape(s.get("academic_year"))%>" <%=sid.equals(String.valueOf(schedule.get("section_id")))?"selected":""%>><%=HtmlUtil.escape(s.get("class_name"))%> — <%=HtmlUtil.escape(s.get("section_name"))%></option><%}%></select></div>
<div><label for="academic_year" class="mb-1 block text-sm font-semibold">Academic year *</label><input id="academic_year" name="academic_year" maxlength="20" required value="<%=HtmlUtil.escape(schedule.get("academic_year"))%>" placeholder="2026-2027" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"></div>
<div class="sm:col-span-2"><label for="subject_id" class="mb-1 block text-sm font-semibold">Subject *</label><select id="subject_id" name="subject_id" required class="w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="">Choose a subject</option><%if(subjects!=null)for(Map<String,Object>s:subjects){String sid=String.valueOf(s.get("id"));%><option value="<%=sid%>" <%=sid.equals(String.valueOf(schedule.get("subject_id")))?"selected":""%>><%=HtmlUtil.escape(s.get("subject_code"))%> — <%=HtmlUtil.escape(s.get("subject_name"))%></option><%}%></select></div>
<div><label for="exam_date" class="mb-1 block text-sm font-semibold">Exam date *</label><input id="exam_date" name="exam_date" type="date" required value="<%=HtmlUtil.escape(schedule.get("exam_date"))%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"></div><div><label for="room" class="mb-1 block text-sm font-semibold">Room</label><input id="room" name="room" maxlength="50" value="<%=HtmlUtil.escape(schedule.get("room"))%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"></div>
<div><label for="start_time" class="mb-1 block text-sm font-semibold">Start time *</label><input id="start_time" name="start_time" type="time" required value="<%=start%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"></div><div><label for="end_time" class="mb-1 block text-sm font-semibold">End time *</label><input id="end_time" name="end_time" type="time" required value="<%=end%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"></div>
</div><div class="flex flex-col-reverse justify-end gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 sm:flex-row sm:px-7"><a href="<%=request.getContextPath()%>/admin/examinations" class="rounded-md border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold">Cancel</a><button class="rounded-md bg-indigo-700 px-5 py-2.5 text-sm font-semibold text-white"><i class="fa-solid fa-check mr-1"></i><%=editing?"Save changes":"Save exam date"%></button></div></form></section></main></div>
<script>const section=document.getElementById('section_id'),year=document.getElementById('academic_year');section.addEventListener('change',()=>{const o=section.options[section.selectedIndex];if(o&&o.dataset.year)year.value=o.dataset.year});if(!year.value&&section.value)section.dispatchEvent(new Event('change'));</script></body></html>
