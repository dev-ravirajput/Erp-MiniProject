<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.util.Map,java.util.List,com.erp.util.HtmlUtil,com.erp.model.User" %>
<%
    boolean editing="update".equals(request.getAttribute("mode")); Map<String,?> record=(Map<String,?>)request.getAttribute("record");
    String pageTitle=editing?"Edit attendance":"Record attendance";
    User sessionUser=(User)session.getAttribute("user");
    String adminDisplayName=sessionUser!=null&&sessionUser.getName()!=null?sessionUser.getName():"Administrator";
    String initial=adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();
    List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("studentOptions"), teachers=(List<Map<String,Object>>)request.getAttribute("teacherOptions"), subjects=(List<Map<String,Object>>)request.getAttribute("subjectOptions"), sections=(List<Map<String,Object>>)request.getAttribute("sectionOptions");
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=editing?"Edit":"Record"%> attendance | EduERP</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body class="bg-slate-100 font-sans text-slate-800"><div class="min-h-screen lg:flex"><%@ include file="admin-nav.jspf" %><main class="min-w-0 flex-1 lg:ml-60"><%@ include file="admin-header.jspf" %><section class="p-4 sm:p-6 lg:p-8"><div class="mb-5"><h2 class="text-2xl font-bold"><%=editing?"Edit attendance":"Record attendance"%></h2><p class="mt-1 text-sm text-slate-500">Choose the student, class section, subject, teacher, date, and attendance status.</p></div>
<%if(request.getAttribute("formError")!=null){%><div class="mb-5 max-w-3xl border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-800"><%=HtmlUtil.escape(request.getAttribute("formError"))%></div><%}%>
<form method="post" action="<%=request.getContextPath()%>/admin/attendance" class="max-w-3xl border border-slate-200 bg-white shadow-sm"><input type="hidden" name="action" value="<%=editing?"update":"create"%>"><%if(editing){%><input type="hidden" name="id" value="<%=HtmlUtil.escape(record.get("id"))%>"><%}%><div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-7">
<div><label for="student_id" class="mb-1 block text-sm font-semibold">Student *</label><select id="student_id" name="student_id" required class="w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="">Select student</option><%if(students!=null)for(Map<String,Object> o:students){String oid=String.valueOf(o.get("id"));%><option value="<%=oid%>" <%=oid.equals(String.valueOf(record.get("student_id")))?"selected":""%>><%=HtmlUtil.escape(o.get("name"))%> — <%=HtmlUtil.escape(o.get("email"))%></option><%}%></select></div>
<div><label for="section_id" class="mb-1 block text-sm font-semibold">Class / section *</label><select id="section_id" name="section_id" required class="w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="">Select class section</option><%if(sections!=null)for(Map<String,Object> o:sections){String oid=String.valueOf(o.get("id"));%><option value="<%=oid%>" <%=oid.equals(String.valueOf(record.get("section_id")))?"selected":""%>><%=HtmlUtil.escape(o.get("class_name"))%> — <%=HtmlUtil.escape(o.get("section_name"))%></option><%}%></select></div>
<div><label for="subject_id" class="mb-1 block text-sm font-semibold">Subject *</label><select id="subject_id" name="subject_id" required class="w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="">Select subject</option><%if(subjects!=null)for(Map<String,Object> o:subjects){String oid=String.valueOf(o.get("id"));%><option value="<%=oid%>" <%=oid.equals(String.valueOf(record.get("subject_id")))?"selected":""%>><%=HtmlUtil.escape(o.get("subject_code"))%> — <%=HtmlUtil.escape(o.get("subject_name"))%></option><%}%></select></div>
<div><label for="teacher_id" class="mb-1 block text-sm font-semibold">Teacher *</label><select id="teacher_id" name="teacher_id" required class="w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="">Select teacher</option><%if(teachers!=null)for(Map<String,Object> o:teachers){String oid=String.valueOf(o.get("id"));%><option value="<%=oid%>" <%=oid.equals(String.valueOf(record.get("teacher_id")))?"selected":""%>><%=HtmlUtil.escape(o.get("name"))%> — <%=HtmlUtil.escape(o.get("email"))%></option><%}%></select></div>
<div><label for="attendance_date" class="mb-1 block text-sm font-semibold">Date *</label><input type="date" id="attendance_date" name="attendance_date" required value="<%=HtmlUtil.escape(record.get("attendance_date"))%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"></div>
<div><label for="status" class="mb-1 block text-sm font-semibold">Status *</label><select id="status" name="status" required class="w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 text-sm"><%for(String s:new String[]{"PRESENT","ABSENT","LATE","LEAVE"}){%><option value="<%=s%>" <%=s.equals(String.valueOf(record.get("status")))?"selected":""%>><%=s%></option><%}%></select></div>
<div class="sm:col-span-2"><label for="remarks" class="mb-1 block text-sm font-semibold">Remarks</label><textarea id="remarks" name="remarks" maxlength="255" rows="3" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"><%=HtmlUtil.escape(record.get("remarks"))%></textarea></div>
</div><div class="flex flex-col-reverse justify-end gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 sm:flex-row sm:px-7"><a href="<%=request.getContextPath()%>/admin/attendance" class="rounded-md border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold">Cancel</a><button class="rounded-md bg-indigo-700 px-5 py-2.5 text-sm font-semibold text-white"><i class="fa-solid fa-check mr-1"></i><%=editing?"Save changes":"Save attendance"%></button></div></form></section></main></div></body></html>
