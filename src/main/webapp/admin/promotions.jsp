<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %><%String pageTitle="Year rollover";User currentUser=(User)session.getAttribute("user");String adminDisplayName=currentUser==null?"Administrator":currentUser.getName();String initial=adminDisplayName==null||adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();
List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students"),sections=(List<Map<String,Object>>)request.getAttribute("sections"),subjects=(List<Map<String,Object>>)request.getAttribute("subjects");
%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Academic rollover</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="space-y-5 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">Academic year rollover</h2><p class="mt-1 text-sm text-slate-500">Create next-year enrollments in a target section while preserving each student's earlier year history.</p></div>
<%if(request.getAttribute("loadError")!=null){%><p class="rounded bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}if(request.getAttribute("formError")!=null){%><p class="rounded bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("formError"))%></p><%}if(request.getParameter("notice")!=null){%><p class="rounded bg-emerald-50 p-4 text-emerald-700"><%=HtmlUtil.escape(request.getParameter("notice"))%> student enrollment(s) created.</p><%}%>
<form method="post" class="space-y-5 rounded-xl bg-white p-5 shadow-sm"><div class="grid gap-4 md:grid-cols-2"><label class="text-sm font-semibold">Target class / section and year<select name="section_id" required class="mt-1 block w-full rounded border px-3 py-2"><option value="">Choose target section</option><%if(sections!=null)for(Map<String,Object> s:sections){%><option value="<%=s.get("id")%>"><%=HtmlUtil.escape(s.get("class_name"))%> · <%=HtmlUtil.escape(s.get("section_name"))%> · <%=HtmlUtil.escape(s.get("academic_year"))%></option><%}%></select></label><label class="text-sm font-semibold">Subjects for the new year<select name="subject_ids" multiple required size="6" class="mt-1 block w-full rounded border px-3 py-2"><%if(subjects!=null)for(Map<String,Object> s:subjects){%><option value="<%=s.get("id")%>"><%=HtmlUtil.escape(s.get("subject_name"))%> · <%=HtmlUtil.escape(s.get("subject_code"))%></option><%}%></select></label></div><div class="flex items-center justify-between"><h3 class="font-bold">Active students</h3><label class="text-sm"><input type="checkbox" onclick="document.querySelectorAll('.student-check').forEach(x=>x.checked=this.checked)"> Select all</label></div><div class="grid max-h-96 gap-2 overflow-auto rounded border p-3 sm:grid-cols-2 lg:grid-cols-3"><%if(students!=null)for(Map<String,Object> s:students){%><label class="flex items-center gap-2 text-sm"><input class="student-check" type="checkbox" name="student_ids" value="<%=s.get("id")%>"><span><%=HtmlUtil.escape(s.get("name"))%> · <%=HtmlUtil.escape(s.get("admission_no"))%></span></label><%}%></div><button class="rounded bg-indigo-700 px-5 py-2.5 font-semibold text-white" onclick="return confirm('Create or update enrollments for the selected academic year?')">Create enrollments</button></form>
</section></main></div></body></html>
