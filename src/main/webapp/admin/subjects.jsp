<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %>
<%
    User sessionUser = (User) session.getAttribute("user");
    String adminDisplayName = sessionUser != null && sessionUser.getName() != null ? sessionUser.getName() : "Administrator";
    String initial = adminDisplayName.isEmpty() ? "A" : adminDisplayName.substring(0, 1).toUpperCase();
    String pageTitle = "Subjects";
    String status = (String) request.getAttribute("status");
    String query = (String) request.getAttribute("query");
    String notice = (String) request.getAttribute("notice");
    List<Map<String, Object>> subjects = (List<Map<String, Object>>) request.getAttribute("subjects");
    String noticeText = "";
    if ("created".equals(notice)) noticeText = "Subject created.";
    else if ("updated".equals(notice)) noticeText = "Subject updated.";
    else if ("status-updated".equals(notice)) noticeText = "Subject status updated.";
    else if ("error".equals(notice)) noticeText = "The subject change could not be completed.";
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Subjects | EduERP</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body class="bg-slate-100 font-sans text-slate-800"><div class="min-h-screen lg:flex"><%@ include file="admin-nav.jspf" %><main class="min-w-0 flex-1 lg:ml-60"><%@ include file="admin-header.jspf" %>
    <section class="space-y-5 p-4 sm:p-6 lg:p-8"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h2 class="text-2xl font-bold text-slate-900">Subject directory</h2><p class="mt-1 text-sm text-slate-500">Manage subject codes, names, maximum marks, and availability.</p></div><a href="<%= request.getContextPath() %>/admin/subjects?action=create" class="inline-flex items-center justify-center gap-2 rounded-md bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-800"><i class="fa-solid fa-plus"></i> Add subject</a></div>
        <% if (!noticeText.isEmpty()) { %><div class="border-l-4 <%= "error".equals(notice) ? "border-rose-500 bg-rose-50 text-rose-800" : "border-emerald-500 bg-emerald-50 text-emerald-800" %> px-4 py-3 text-sm" role="status"><%= HtmlUtil.escape(noticeText) %></div><% } %>
        <% if (request.getAttribute("loadError") != null) { %><div class="border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-800" role="alert"><%= HtmlUtil.escape(request.getAttribute("loadError")) %></div><% } %>
        <form action="<%= request.getContextPath() %>/admin/subjects" method="get" class="flex flex-col gap-2 sm:flex-row"><label class="sr-only" for="subject-search">Search subjects</label><div class="flex rounded-md border border-slate-300 bg-white"><span class="flex items-center pl-3 text-slate-400"><i class="fa-solid fa-magnifying-glass"></i></span><input id="subject-search" class="min-w-0 px-3 py-2 text-sm outline-none" type="search" name="q" value="<%= HtmlUtil.escape(query) %>" placeholder="Subject code or name"></div><label class="sr-only" for="status-filter">Filter by status</label><select id="status-filter" name="status" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm"><option value="all" <%= "all".equals(status) ? "selected" : "" %>>All statuses</option><option value="active" <%= "active".equals(status) ? "selected" : "" %>>Active</option><option value="inactive" <%= "inactive".equals(status) ? "selected" : "" %>>Inactive</option></select><button class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold hover:bg-slate-50" type="submit">Filter</button></form>
        <div class="overflow-hidden border border-slate-200 bg-white shadow-sm"><div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 sm:px-5"><h3 class="font-semibold text-slate-900">All subjects</h3><span class="text-sm text-slate-500"><%= subjects == null ? 0 : subjects.size() %> subjects</span></div><div class="overflow-x-auto"><table class="w-full min-w-[720px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3 font-semibold">Code</th><th class="px-4 py-3 font-semibold">Subject</th><th class="px-4 py-3 font-semibold">Maximum marks</th><th class="px-4 py-3 font-semibold">Status</th><th class="px-5 py-3 text-right font-semibold">Actions</th></tr></thead><tbody class="divide-y divide-slate-100">
            <% if (subjects == null || subjects.isEmpty()) { %><tr><td colspan="5" class="px-5 py-12 text-center text-slate-500"><i class="fa-solid fa-book-open mb-3 block text-2xl text-slate-300"></i>No subjects match this view.</td></tr><% } else { for (Map<String, Object> subject : subjects) { boolean active = ((Number) subject.get("status")).intValue() != 0; %>
            <tr class="hover:bg-slate-50/70"><td class="px-5 py-4 font-semibold text-slate-700"><%= HtmlUtil.escape(subject.get("subject_code")) %></td><td class="px-4 py-4 font-medium text-slate-900"><%= HtmlUtil.escape(subject.get("subject_name")) %></td><td class="px-4 py-4 text-slate-600"><%= HtmlUtil.escape(subject.get("max_marks")) %></td><td class="px-4 py-4"><span class="inline-flex rounded-sm <%= active ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700" %> px-2 py-1 text-xs font-semibold"><%= active ? "Active" : "Inactive" %></span></td><td class="px-5 py-4"><div class="flex justify-end gap-2"><a href="<%= request.getContextPath() %>/admin/subjects?action=edit&amp;id=<%= subject.get("id") %>" class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold hover:bg-slate-50"><i class="fa-solid fa-pen mr-1"></i>Edit</a><form action="<%= request.getContextPath() %>/admin/subjects" method="post"><input type="hidden" name="action" value="toggle"><input type="hidden" name="id" value="<%= subject.get("id") %>"><button class="rounded-md border border-amber-300 px-3 py-1.5 text-xs font-semibold text-amber-800 hover:bg-amber-50" type="submit"><i class="fa-solid fa-power-off mr-1"></i><%= active ? "Deactivate" : "Activate" %></button></form></div></td></tr>
            <% } } %>
        </tbody></table></div></div>
    </section>
</main></div></body></html>
