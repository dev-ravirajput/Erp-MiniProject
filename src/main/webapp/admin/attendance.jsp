<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %>
<%
    List<Map<String,Object>> records=(List<Map<String,Object>>)request.getAttribute("records");
    String dateFilter=(String)request.getAttribute("dateFilter"), statusFilter=(String)request.getAttribute("statusFilter");
    String pageTitle="Attendance";
    User sessionUser=(User)session.getAttribute("user");
    String adminDisplayName=sessionUser!=null&&sessionUser.getName()!=null?sessionUser.getName():"Administrator";
    String initial=adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();
    String notice=request.getParameter("notice"), noticeText="";
    if("created".equals(notice))noticeText="Attendance record added.";else if("updated".equals(notice))noticeText="Attendance record updated.";else if("deleted".equals(notice))noticeText="Attendance record deleted.";else if("error".equals(notice))noticeText="That attendance change could not be completed.";
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Attendance | EduERP</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body class="bg-slate-100 font-sans text-slate-800"><div class="min-h-screen lg:flex"><%@ include file="admin-nav.jspf" %><main class="min-w-0 flex-1 lg:ml-60"><%@ include file="admin-header.jspf" %>
<section class="space-y-5 p-4 sm:p-6 lg:p-8"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h2 class="text-2xl font-bold text-slate-900">Attendance management</h2><p class="mt-1 text-sm text-slate-500">Create, review, edit, and remove student attendance records.</p></div><a href="<%=request.getContextPath()%>/admin/attendance?action=create" class="rounded-md bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-800"><i class="fa-solid fa-plus mr-2"></i>Record attendance</a></div>
<%if(!noticeText.isEmpty()){%><div class="border-l-4 border-emerald-500 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%=HtmlUtil.escape(noticeText)%></div><%}%><%if(request.getAttribute("loadError")!=null){%><div class="border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-800"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></div><%}%>
<form method="get" action="<%=request.getContextPath()%>/admin/attendance" class="flex flex-wrap gap-2"><input type="date" name="date" value="<%=HtmlUtil.escape(dateFilter)%>" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm"><select name="status" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm"><option value="">All statuses</option><%for(String s:new String[]{"PRESENT","ABSENT","LATE","LEAVE"}){%><option value="<%=s%>" <%=(s.equals(statusFilter)?"selected":"")%>><%=s%></option><%}%></select><button class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold">Filter</button><a href="<%=request.getContextPath()%>/admin/attendance" class="rounded-md px-3 py-2 text-sm text-slate-600 hover:bg-white">Clear</a></form>
<div class="overflow-hidden border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-200 px-5 py-3 font-semibold">Attendance records <span class="ml-1 text-sm font-normal text-slate-500">(<%=records==null?0:records.size()%>)</span></div><div class="overflow-x-auto"><table class="w-full min-w-[900px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Date</th><th class="px-4 py-3">Student</th><th class="px-4 py-3">Class / section</th><th class="px-4 py-3">Subject</th><th class="px-4 py-3">Teacher</th><th class="px-4 py-3">Status</th><th class="px-4 py-3 text-right">Actions</th></tr></thead><tbody class="divide-y divide-slate-100">
<%if(records==null||records.isEmpty()){%><tr><td colspan="7" class="px-5 py-10 text-center text-slate-500">No attendance records found.</td></tr><%}else for(Map<String,Object> r:records){%><tr><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("attendance_date"))%></td><td class="px-4 py-3 font-medium"><%=HtmlUtil.escape(r.get("student_name"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("class_name"))%> / <%=HtmlUtil.escape(r.get("section_name"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("subject_name"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("teacher_name"))%></td><td class="px-4 py-3"><span class="rounded bg-slate-100 px-2 py-1 text-xs font-semibold"><%=HtmlUtil.escape(r.get("status"))%></span></td><td class="px-4 py-3"><div class="flex justify-end gap-2"><a class="rounded border border-slate-300 px-3 py-1.5 text-xs font-semibold" href="<%=request.getContextPath()%>/admin/attendance?action=edit&amp;id=<%=r.get("id")%>">Edit</a><form method="post" action="<%=request.getContextPath()%>/admin/attendance" onsubmit="return confirm('Delete this attendance record?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=r.get("id")%>"><button class="rounded border border-rose-300 px-3 py-1.5 text-xs font-semibold text-rose-700">Delete</button></form></div></td></tr><%}%>
</tbody></table></div></div></section></main></div></body></html>
