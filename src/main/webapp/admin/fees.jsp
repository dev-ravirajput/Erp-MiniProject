<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %><%String pageTitle="Fees";User currentUser=(User)session.getAttribute("user");String adminDisplayName=currentUser==null?"Administrator":currentUser.getName();String initial=adminDisplayName==null||adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();
List<Map<String,Object>> invoices=(List<Map<String,Object>>)request.getAttribute("invoices"),students=(List<Map<String,Object>>)request.getAttribute("studentOptions"),plans=(List<Map<String,Object>>)request.getAttribute("feePlans"),classes=(List<Map<String,Object>>)request.getAttribute("classOptions"),payments=(List<Map<String,Object>>)request.getAttribute("payments");Map<String,Object> selected=(Map<String,Object>)request.getAttribute("paymentInvoice"),receipt=(Map<String,Object>)request.getAttribute("receipt");
%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Fees</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="space-y-5 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">Fees and payments</h2><p class="mt-1 text-sm text-slate-500">Create fee plans and invoices, record payments and concessions, and track overdue balances.</p></div>
<%if(request.getAttribute("loadError")!=null){%><p class="rounded bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}if(request.getAttribute("formError")!=null){%><p class="rounded bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("formError"))%></p><%}String notice=request.getParameter("notice");if(notice!=null){%><p class="rounded bg-emerald-50 p-4 text-emerald-700">Fee update saved: <%=HtmlUtil.escape(notice.replace('_',' '))%>.</p><%}%>
<div class="grid gap-5 xl:grid-cols-2"><form method="post" class="grid gap-3 rounded-xl bg-white p-5 shadow-sm sm:grid-cols-2"><input type="hidden" name="action" value="create_plan"><h3 class="font-bold sm:col-span-2">Create class fee plan</h3><label class="text-sm">Class<select name="class_id" required class="mt-1 block w-full rounded border px-3 py-2"><option value="">Select active class</option><%if(classes!=null)for(Map<String,Object> c:classes){%><option value="<%=c.get("id")%>"><%=HtmlUtil.escape(c.get("class_name"))%> · <%=HtmlUtil.escape(c.get("academic_year"))%></option><%}%></select></label><label class="text-sm">Plan title<input name="title" maxlength="150" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Amount<input name="amount" type="number" min="0.01" step="0.01" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Due date<input name="due_date" type="date" required class="mt-1 block w-full rounded border px-3 py-2"></label><button class="rounded bg-indigo-700 px-4 py-2 font-semibold text-white sm:col-span-2">Create fee plan</button></form>
<form method="post" class="grid gap-3 rounded-xl bg-white p-5 shadow-sm sm:grid-cols-2"><input type="hidden" name="action" value="create_invoice"><h3 class="font-bold sm:col-span-2">Create student invoice from plan</h3><label class="text-sm">Student<select id="invoice-student" name="student_id" required class="mt-1 block w-full rounded border px-3 py-2"><option value="">Select student</option><%if(students!=null)for(Map<String,Object> s:students){%><option value="<%=s.get("id")%>" data-class-id="<%=s.get("class_id")==null?"":s.get("class_id")%>" data-class-name="<%=HtmlUtil.escape(s.get("class_name"))%>" data-academic-year="<%=HtmlUtil.escape(s.get("academic_year"))%>"><%=HtmlUtil.escape(s.get("name"))%> · <%=HtmlUtil.escape(s.get("admission_no"))%></option><%}%></select></label><label class="text-sm">Fee plan<select id="invoice-plan" name="plan_id" required class="mt-1 block w-full rounded border px-3 py-2"><option value="">Choose a student first</option><%if(plans!=null)for(Map<String,Object> p:plans){%><option value="<%=p.get("id")%>" data-class-id="<%=p.get("class_id")%>" data-academic-year="<%=HtmlUtil.escape(p.get("academic_year"))%>"><%=HtmlUtil.escape(p.get("title"))%> · <%=HtmlUtil.escape(p.get("class_name"))%> · <%=HtmlUtil.escape(p.get("academic_year"))%> · <%=HtmlUtil.escape(p.get("amount"))%></option><%}%></select></label><label class="text-sm">Concession / scholarship<input name="concession_amount" type="number" min="0" step="0.01" value="0.00" class="mt-1 block w-full rounded border px-3 py-2"></label><p id="fee-plan-match-note" class="self-center text-xs text-slate-500">Choose a student to automatically match a plan to their current class and academic year.</p><button class="rounded bg-indigo-700 px-4 py-2 font-semibold text-white sm:col-span-2">Create invoice</button></form></div>
<script>
(()=>{
  const studentSelect=document.getElementById("invoice-student");
  const planSelect=document.getElementById("invoice-plan");
  const note=document.getElementById("fee-plan-match-note");
  function matchFeePlan(){
    const student=studentSelect.options[studentSelect.selectedIndex];
    const classId=student?student.dataset.classId:"";
    const year=student?student.dataset.academicYear:"";
    const available=Array.from(planSelect.options).filter(option=>option.value!=="");
    const matches=available.filter(option=>classId!==""&&option.dataset.classId===classId&&option.dataset.academicYear===year);
    available.forEach(option=>{option.hidden=!matches.includes(option);});
    planSelect.value=matches.length?matches[0].value:"";
    if(!studentSelect.value){note.textContent="Choose a student to automatically match a fee plan.";}
    else if(!classId||!year){note.textContent="This student has no current class enrollment. Assign a class before creating a fee invoice.";}
    else if(matches.length===0){note.textContent="No active fee plan matches this student's current class and academic year.";}
    else if(matches.length===1){note.textContent="Fee plan automatically selected for "+student.dataset.className+" ("+year+").";}
    else{note.textContent="Several plans match this class and year. The first was selected; you can choose another matching plan.";}
  }
  studentSelect.addEventListener("change",matchFeePlan);
  matchFeePlan();
})();
</script>
<div class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full min-w-[850px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Student / invoice</th><th class="px-4 py-3">Year</th><th class="px-4 py-3">Due</th><th class="px-4 py-3">Fee</th><th class="px-4 py-3">Concession</th><th class="px-4 py-3">Net paid</th><th class="px-4 py-3">Balance</th><th class="px-4 py-3">Payments</th></tr></thead><tbody><%if(invoices!=null)for(Map<String,Object> i:invoices){boolean overdue=i.get("overdue") instanceof Number&&((Number)i.get("overdue")).intValue()==1;%><tr class="border-t"><td class="px-4 py-3"><div class="font-semibold"><%=HtmlUtil.escape(i.get("student_name"))%></div><div><%=HtmlUtil.escape(i.get("title"))%> · <%=HtmlUtil.escape(i.get("admission_no"))%></div></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("academic_year"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("due_date"))%><%if(overdue){%><div class="text-xs font-semibold text-rose-700">Overdue</div><%}%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("amount"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("concession_amount"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(i.get("paid_amount"))%></td><td class="px-4 py-3 font-semibold"><%=HtmlUtil.escape(i.get("balance"))%></td><td class="px-4 py-3"><a class="text-indigo-700" href="?invoice_id=<%=i.get("id")%>">View / pay</a></td></tr><%}%><%if(invoices==null||invoices.isEmpty()){%><tr><td colspan="8" class="p-8 text-center text-slate-500">No invoices yet.</td></tr><%}%></tbody></table></div>
<%if(selected!=null){%><section class="grid gap-5 rounded-xl bg-white p-5 shadow-sm lg:grid-cols-2"><div><h3 class="font-bold">Record payment</h3><form method="post" class="mt-3 grid gap-3 sm:grid-cols-2"><input type="hidden" name="action" value="record_payment"><input type="hidden" name="invoice_id" value="<%=selected.get("id")%>"><label class="text-sm">Amount<input name="amount" type="number" min="0.01" step="0.01" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Method<select name="payment_method" class="mt-1 block w-full rounded border px-3 py-2"><%for(String method:new String[]{"CASH","BANK_TRANSFER","CARD","ONLINE","OTHER"}){%><option><%=method%></option><%}%></select></label><label class="text-sm">Reference<input name="reference_no" maxlength="100" class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Notes<input name="notes" maxlength="500" class="mt-1 block w-full rounded border px-3 py-2"></label><button class="rounded bg-emerald-700 px-4 py-2 font-semibold text-white sm:col-span-2">Record payment</button></form></div><div><h3 class="font-bold">Payment history</h3><div class="mt-3 space-y-3"><%if(payments!=null)for(Map<String,Object> p:payments){%><article class="rounded border p-3 text-sm"><p><strong><%=HtmlUtil.escape(p.get("amount"))%></strong> · <%=HtmlUtil.escape(p.get("payment_method"))%> · <%=HtmlUtil.escape(p.get("paid_at"))%></p><p class="text-xs text-slate-500">Reference <%=HtmlUtil.escape(p.get("reference_no"))%> · Received by <%=HtmlUtil.escape(p.get("received_by"))%> · Refunded <%=HtmlUtil.escape(p.get("refunded_amount"))%></p><a class="mt-1 inline-block text-indigo-700" href="?receipt_id=<%=p.get("id")%>">View receipt</a><form method="post" class="mt-3 flex flex-wrap items-end gap-2 border-t pt-3"><input type="hidden" name="action" value="record_refund"><input type="hidden" name="invoice_id" value="<%=selected.get("id")%>"><input type="hidden" name="payment_id" value="<%=p.get("id")%>"><label class="text-xs">Refund amount<input name="amount" type="number" min="0.01" max="<%=((java.math.BigDecimal)p.get("amount")).subtract((java.math.BigDecimal)p.get("refunded_amount"))%>" step="0.01" required class="mt-1 block rounded border px-2 py-1.5"></label><label class="text-xs">Reference<input name="reference_no" maxlength="100" class="mt-1 block rounded border px-2 py-1.5"></label><label class="text-xs">Notes<input name="notes" maxlength="500" class="mt-1 block rounded border px-2 py-1.5"></label><button class="rounded border border-amber-300 px-3 py-1.5 text-amber-900">Record refund</button></form></article><%}%><%if(payments==null||payments.isEmpty()){%><p class="text-sm text-slate-500">No payments recorded.</p><%}%></div></div></section><%}%>
<%if(receipt!=null){%><section class="mx-auto max-w-2xl rounded-xl border bg-white p-6 shadow-sm print:shadow-none"><div class="flex items-start justify-between"><div><h3 class="text-xl font-bold">Payment receipt</h3><p class="text-sm text-slate-500">Receipt #<%=HtmlUtil.escape(receipt.get("receipt_id"))%></p></div><button onclick="window.print()" class="rounded border px-3 py-2 text-sm print:hidden">Print</button></div><dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2"><div><dt class="text-slate-500">Student</dt><dd class="font-semibold"><%=HtmlUtil.escape(receipt.get("student_name"))%> · <%=HtmlUtil.escape(receipt.get("admission_no"))%></dd></div><div><dt class="text-slate-500">Invoice</dt><dd class="font-semibold"><%=HtmlUtil.escape(receipt.get("title"))%> · <%=HtmlUtil.escape(receipt.get("academic_year"))%></dd></div><div><dt class="text-slate-500">Payment</dt><dd class="font-semibold"><%=HtmlUtil.escape(receipt.get("amount"))%> · <%=HtmlUtil.escape(receipt.get("payment_method"))%></dd></div><div><dt class="text-slate-500">Date</dt><dd class="font-semibold"><%=HtmlUtil.escape(receipt.get("paid_at"))%></dd></div><div><dt class="text-slate-500">Reference</dt><dd><%=HtmlUtil.escape(receipt.get("reference_no"))%></dd></div><div><dt class="text-slate-500">Received by</dt><dd><%=HtmlUtil.escape(receipt.get("received_by"))%></dd></div></dl></section><%}%>
</section></main></div></body></html>
