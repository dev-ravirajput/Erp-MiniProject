<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %><%
List<Map<String,Object>> entries=(List<Map<String,Object>>)request.getAttribute("entries");List<Map<String,Object>> sections=(List<Map<String,Object>>)request.getAttribute("sectionOptions");String filter=(String)request.getAttribute("sectionFilter");String notice=request.getParameter("notice"),message="";if("created".equals(notice))message="Timetable period added.";else if("updated".equals(notice))message="Timetable period updated.";else if("deleted".equals(notice))message="Timetable period removed.";else if("error".equals(notice))message="That change could not be completed.";String pageTitle="Timetable";User sessionUser=(User)session.getAttribute("user");String adminDisplayName=sessionUser!=null&&sessionUser.getName()!=null?sessionUser.getName():"Administrator";String initial=adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Timetable | EduERP</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 font-sans text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="space-y-5 p-4 sm:p-6 lg:p-8">
<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h2 class="text-2xl font-bold">Weekly class timetable</h2><p class="mt-1 text-sm text-slate-500">Assign subjects, teachers, periods, and rooms to each class section.</p></div><a href="<%=request.getContextPath()%>/admin/timetable?action=create" class="rounded-md bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-800"><i class="fa-solid fa-plus mr-2"></i>Add timetable period</a></div>
<%if(!message.isEmpty()){%><div class="border-l-4 border-emerald-500 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%=HtmlUtil.escape(message)%></div><%}%><%if(request.getAttribute("loadError")!=null){%><div class="border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-800"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></div><%}%>
<form action="<%=request.getContextPath()%>/admin/timetable" method="get" class="flex flex-wrap gap-2"><select name="section_id" class="min-w-64 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm"><option value="">All class timetables</option><%if(sections!=null)for(Map<String,Object>s:sections){String sid=String.valueOf(s.get("id"));%><option value="<%=sid%>" <%=sid.equals(filter)?"selected":""%>><%=HtmlUtil.escape(s.get("class_name"))%> — <%=HtmlUtil.escape(s.get("section_name"))%> (<%=HtmlUtil.escape(s.get("academic_year"))%>)</option><%}%></select><button class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold">View timetable</button></form>
<div class="overflow-hidden border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-200 px-5 py-3"><h3 class="font-semibold">Weekly periods</h3><p class="mt-1 text-xs text-slate-500">Periods are ordered by class, section, weekday, and start time. A section or teacher cannot be assigned overlapping periods.</p></div><div class="overflow-x-auto"><table class="w-full min-w-[950px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Class / section</th><th class="px-4 py-3">Day</th><th class="px-4 py-3">Time</th><th class="px-4 py-3">Subject</th><th class="px-4 py-3">Teacher</th><th class="px-4 py-3">Room</th><th class="px-4 py-3 text-right">Actions</th></tr></thead><tbody class="divide-y divide-slate-100">
<%if(entries==null||entries.isEmpty()){%><tr><td colspan="7" class="px-5 py-10 text-center text-slate-500">No timetable periods found for this view.</td></tr><%}else for(Map<String,Object>e:entries){%><tr><td class="px-4 py-3"><div class="font-medium"><%=HtmlUtil.escape(e.get("class_name"))%> / <%=HtmlUtil.escape(e.get("section_name"))%></div><div class="text-xs text-slate-500"><%=HtmlUtil.escape(e.get("academic_year"))%></div></td><td class="px-4 py-3 font-semibold"><%=HtmlUtil.escape(e.get("day_of_week"))%></td><td class="whitespace-nowrap px-4 py-3"><%=HtmlUtil.escape(e.get("start_time"))%>–<%=HtmlUtil.escape(e.get("end_time"))%></td><td class="px-4 py-3"><div class="font-medium"><%=HtmlUtil.escape(e.get("subject_name"))%></div><div class="text-xs text-slate-500"><%=HtmlUtil.escape(e.get("subject_code"))%></div></td><td class="px-4 py-3"><%=HtmlUtil.escape(e.get("teacher_name"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(e.get("room"))%></td><td class="px-4 py-3"><div class="flex justify-end gap-2"><a class="rounded border border-slate-300 px-3 py-1.5 text-xs font-semibold" href="<%=request.getContextPath()%>/admin/timetable?action=edit&amp;id=<%=e.get("id")%>">Edit</a><form method="post" action="<%=request.getContextPath()%>/admin/timetable" onsubmit="return confirm('Remove this timetable period?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=e.get("id")%>"><button class="rounded border border-rose-300 px-3 py-1.5 text-xs font-semibold text-rose-700">Delete</button></form></div></td></tr><%}%>
</tbody></table></div></div></section></main></div></body></html>
