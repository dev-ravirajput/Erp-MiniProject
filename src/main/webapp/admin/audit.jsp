<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %><%String pageTitle="Audit history";User currentUser=(User)session.getAttribute("user");String adminDisplayName=currentUser==null?"Administrator":currentUser.getName();String initial=adminDisplayName==null||adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("auditRows");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audit history</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="space-y-4 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">Audit history</h2><p class="mt-1 text-sm text-slate-500">Most recent successful account and academic record changes.</p></div><%if(request.getAttribute("loadError")!=null){%><p class="rounded bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><div class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full min-w-[760px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Time</th><th class="px-4 py-3">User</th><th class="px-4 py-3">Action</th><th class="px-4 py-3">Area</th><th class="px-4 py-3">Record</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object> r:rows){%><tr class="border-t"><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("created_at"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("actor_name"))%><div class="text-xs text-slate-500"><%=HtmlUtil.escape(r.get("actor_email"))%></div></td><td class="px-4 py-3 font-semibold"><%=HtmlUtil.escape(r.get("action"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("entity_type"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("entity_id"))%></td></tr><%}%><%if(rows==null||rows.isEmpty()){%><tr><td colspan="5" class="p-8 text-center text-slate-500">No changes have been recorded.</td></tr><%}%></tbody></table></div></section></main></div></body></html>
