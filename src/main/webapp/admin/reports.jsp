<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %><%
List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("attendanceReport");List<Map<String,Object>> sections=(List<Map<String,Object>>)request.getAttribute("sectionOptions");String selected=(String)request.getAttribute("sectionFilter"),from=(String)request.getAttribute("fromDate"),to=(String)request.getAttribute("toDate"),year=(String)request.getAttribute("yearFilter");List<String> years=(List<String>)request.getAttribute("academicYears");String pageTitle="Reports";User sessionUser=(User)session.getAttribute("user");String adminDisplayName=sessionUser!=null&&sessionUser.getName()!=null?sessionUser.getName():"Administrator";String initial=adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();long total=0,present=0,absent=0,late=0,leaves=0;if(rows!=null)for(Map<String,Object>r:rows){total+=((Number)r.get("total")).longValue();present+=((Number)r.get("present")).longValue();absent+=((Number)r.get("absent")).longValue();late+=((Number)r.get("late")).longValue();leaves+=((Number)r.get("leaves")).longValue();}%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reports | EduERP</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 font-sans text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="space-y-5 p-4 sm:p-6 lg:p-8">
<div><h2 class="text-2xl font-bold">Institution reports</h2><p class="mt-1 text-sm text-slate-500">Review student attendance totals for the current class and section assignments.</p></div>
<%if(request.getAttribute("loadError")!=null){%><div class="border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-800"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></div><%}%>
<form action="<%=request.getContextPath()%>/admin/reports" method="get" class="flex flex-wrap items-end gap-3 border border-slate-200 bg-white p-4 shadow-sm"><div><label for="section_id" class="mb-1 block text-xs font-semibold text-slate-600">Class / section</label><select id="section_id" name="section_id" class="min-w-56 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm"><option value="">All enrollment years</option><%if(sections!=null)for(Map<String,Object>s:sections){String sid=String.valueOf(s.get("id"));%><option value="<%=sid%>" <%=sid.equals(selected)?"selected":""%>><%=HtmlUtil.escape(s.get("class_name"))%> — <%=HtmlUtil.escape(s.get("section_name"))%> (<%=HtmlUtil.escape(s.get("academic_year"))%>)</option><%}%></select></div><div><label for="academic_year" class="mb-1 block text-xs font-semibold text-slate-600">Academic year</label><select id="academic_year" name="academic_year" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm"><option value="">All years</option><%if(years!=null)for(String y:years){%><option value="<%=HtmlUtil.escape(y)%>" <%=y.equals(year)?"selected":""%>><%=HtmlUtil.escape(y)%></option><%}%></select></div><div><label for="from" class="mb-1 block text-xs font-semibold text-slate-600">From</label><input id="from" type="date" name="from" value="<%=HtmlUtil.escape(from)%>" class="rounded-md border border-slate-300 px-3 py-2 text-sm"></div><div><label for="to" class="mb-1 block text-xs font-semibold text-slate-600">To</label><input id="to" type="date" name="to" value="<%=HtmlUtil.escape(to)%>" class="rounded-md border border-slate-300 px-3 py-2 text-sm"></div><button class="rounded-md bg-indigo-700 px-4 py-2 text-sm font-semibold text-white">Generate report</button><button name="format" value="csv" class="rounded-md border border-indigo-200 px-4 py-2 text-sm font-semibold text-indigo-700">Export CSV</button><a href="<%=request.getContextPath()%>/admin/reports" class="rounded-md px-3 py-2 text-sm text-slate-600 hover:bg-slate-50">Reset</a></form>
<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5"><%String[] labels={"Sessions","Present","Absent","Late","Leave"};long[] values={total,present,absent,late,leaves};String[] colors={"text-slate-900","text-emerald-700","text-rose-700","text-amber-700","text-blue-700"};for(int i=0;i<labels.length;i++){%><div class="border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs text-slate-500"><%=labels[i]%></p><p class="mt-1 text-2xl font-bold <%=colors[i]%>"><%=values[i]%></p></div><%}%></div>
<div class="overflow-hidden border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-200 px-5 py-3"><h3 class="font-semibold">Attendance by student</h3><p class="mt-1 text-xs text-slate-500">Rows match each student's academic-year enrollment and attendance records.</p></div><div class="overflow-x-auto"><table class="w-full min-w-[800px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Academic year</th><th class="px-4 py-3">Student</th><th class="px-4 py-3">Admission no.</th><th class="px-4 py-3">Roll no.</th><th class="px-4 py-3">Sessions</th><th class="px-4 py-3">Present</th><th class="px-4 py-3">Absent</th><th class="px-4 py-3">Late</th><th class="px-4 py-3">Leave</th></tr></thead><tbody class="divide-y divide-slate-100">
<%if(rows==null||rows.isEmpty()){%><tr><td colspan="9" class="px-5 py-10 text-center text-slate-500">No current student enrollments match this report.</td></tr><%}else for(Map<String,Object>r:rows){%><tr><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("academic_year"))%></td><td class="px-4 py-3 font-semibold"><%=HtmlUtil.escape(r.get("name"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("admission_no"))%></td><td class="px-4 py-3"><%=HtmlUtil.escape(r.get("roll_no"))%></td><td class="px-4 py-3"><%=r.get("total")%></td><td class="px-4 py-3 text-emerald-700"><%=r.get("present")%></td><td class="px-4 py-3 text-rose-700"><%=r.get("absent")%></td><td class="px-4 py-3 text-amber-700"><%=r.get("late")%></td><td class="px-4 py-3 text-blue-700"><%=r.get("leaves")%></td></tr><%}%>
</tbody></table></div></div></section></main></div></body></html>
