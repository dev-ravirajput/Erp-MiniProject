<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,java.math.BigDecimal,com.erp.util.HtmlUtil,com.erp.model.User" %><%String pageTitle="Grade scales";User currentUser=(User)session.getAttribute("user");String adminDisplayName=currentUser==null?"Administrator":currentUser.getName();String initial=adminDisplayName==null||adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("gradeScales");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Grade scales</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="space-y-5 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">Grade scales</h2><p class="mt-1 text-sm text-slate-500">Published results use the active threshold with the highest matching percentage.</p></div><%if(request.getAttribute("loadError")!=null){%><p class="rounded bg-rose-50 p-4"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}if(request.getAttribute("formError")!=null){%><p class="rounded bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("formError"))%></p><%}%><div class="grid gap-5 lg:grid-cols-[1fr_22rem]"><div class="rounded-xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Minimum percentage</th><th class="px-4 py-3">Grade</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Action</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object> row:rows){%><tr class="border-t"><td class="px-4 py-3"><%=HtmlUtil.escape(row.get("min_percent"))%>%</td><td class="px-4 py-3 font-bold"><%=HtmlUtil.escape(row.get("grade_label"))%></td><td class="px-4 py-3"><%=Integer.valueOf(1).equals(row.get("status"))?"Active":"Inactive"%></td><td class="px-4 py-3"><%if(((BigDecimal)row.get("min_percent")).compareTo(BigDecimal.ZERO)!=0){%><form method="post"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="text-rose-700">Deactivate</button></form><%}%></td></tr><%}%></tbody></table></div><form method="post" class="space-y-3 rounded-xl bg-white p-5 shadow-sm"><h3 class="font-bold">Add grade threshold</h3><label class="block text-sm">Minimum percentage<input name="min_percent" type="number" min="0" max="100" step="0.01" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="block text-sm">Grade label<input name="grade_label" maxlength="10" required class="mt-1 block w-full rounded border px-3 py-2"></label><button class="rounded bg-indigo-700 px-4 py-2 font-semibold text-white">Add grade</button></form></div></section></main></div></body></html>
