<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %><%String pageTitle="Admissions";User currentUser=(User)session.getAttribute("user");String adminDisplayName=currentUser==null?"Administrator":currentUser.getName();String initial=adminDisplayName==null||adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();
List<Map<String,Object>> applications=(List<Map<String,Object>>)request.getAttribute("applications"),classes=(List<Map<String,Object>>)request.getAttribute("classOptions"),sections=(List<Map<String,Object>>)request.getAttribute("sectionOptions");
%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admissions</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="space-y-5 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">Admissions</h2><p class="mt-1 text-sm text-slate-500">Track applications through review, acceptance, and student enrollment.</p></div>
<%if(request.getAttribute("loadError")!=null){%><p class="rounded bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}if(request.getAttribute("formError")!=null){%><p class="rounded bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("formError"))%></p><%}if(request.getParameter("notice")!=null){%><p class="rounded bg-emerald-50 p-4 text-emerald-700">Admission update saved.</p><%}%>
<form method="post" class="grid gap-3 rounded-xl bg-white p-5 shadow-sm md:grid-cols-4"><input type="hidden" name="action" value="create"><h3 class="font-bold md:col-span-4">Receive application</h3><label class="text-sm">Applicant name<input name="applicant_name" maxlength="150" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Email<input name="applicant_email" type="email" maxlength="150" class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Phone<input name="applicant_phone" maxlength="30" class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Date of birth<input name="date_of_birth" type="date" class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Academic year<input name="academic_year" maxlength="20" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-sm">Requested class<select name="requested_class_id" class="mt-1 block w-full rounded border px-3 py-2"><option value="">Not selected</option><%if(classes!=null)for(Map<String,Object> c:classes){%><option value="<%=c.get("id")%>"><%=HtmlUtil.escape(c.get("class_name"))%> · <%=HtmlUtil.escape(c.get("academic_year"))%></option><%}%></select></label><label class="text-sm md:col-span-2">Notes<textarea name="notes" maxlength="10000" rows="2" class="mt-1 block w-full rounded border px-3 py-2"></textarea></label><button class="rounded bg-indigo-700 px-4 py-2 font-semibold text-white md:col-span-4 md:justify-self-start">Create application</button></form>
<div class="space-y-4"><%if(applications!=null)for(Map<String,Object> a:applications){String status=String.valueOf(a.get("status"));%><article class="space-y-3 rounded-xl bg-white p-5 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="font-bold"><%=HtmlUtil.escape(a.get("applicant_name"))%> <span class="text-xs font-normal text-slate-500">· <%=HtmlUtil.escape(a.get("application_no"))%></span></p><p class="text-sm text-slate-500"><%=HtmlUtil.escape(a.get("applicant_email"))%> · <%=HtmlUtil.escape(a.get("applicant_phone"))%> · Requested <%=HtmlUtil.escape(a.get("class_name"))%> / <%=HtmlUtil.escape(a.get("academic_year"))%></p></div><span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold"><%=HtmlUtil.escape(status.replace('_',' '))%></span></div>
<%if(!"ENROLLED".equals(status)){%><div class="flex flex-wrap gap-3"><form method="post" class="flex gap-2"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="<%=a.get("id")%>"><select name="status" class="rounded border px-3 py-2 text-sm"><%for(String s:new String[]{"RECEIVED","UNDER_REVIEW","ACCEPTED","REJECTED"}){%><option value="<%=s%>" <%=s.equals(status)?"selected":""%>><%=s.replace('_',' ')%></option><%}%></select><button class="rounded border px-3 py-2 text-sm">Update status</button></form>
<%if("ACCEPTED".equals(status)){%><details class="flex-1"><summary class="cursor-pointer rounded border border-emerald-300 px-3 py-2 text-sm font-semibold text-emerald-800">Enroll as student</summary><form method="post" class="mt-3 grid gap-2 rounded bg-emerald-50 p-3 sm:grid-cols-3"><input type="hidden" name="action" value="enroll"><input type="hidden" name="id" value="<%=a.get("id")%>"><label class="text-xs">Admission number<input name="admission_no" maxlength="50" required class="mt-1 block w-full rounded border px-2 py-2"></label><label class="text-xs">Roll number<input name="roll_no" maxlength="50" class="mt-1 block w-full rounded border px-2 py-2"></label><label class="text-xs">Academic year<input name="academic_year" value="<%=HtmlUtil.escape(a.get("academic_year"))%>" maxlength="20" required class="mt-1 block w-full rounded border px-2 py-2"></label><label class="text-xs">Phone<input name="phone" maxlength="20" value="<%=HtmlUtil.escape(a.get("applicant_phone"))%>" class="mt-1 block w-full rounded border px-2 py-2"></label><label class="text-xs">Section<select name="section_id" required class="mt-1 block w-full rounded border px-2 py-2"><%if(sections!=null)for(Map<String,Object> s:sections){if(String.valueOf(s.get("academic_year")).equals(String.valueOf(a.get("academic_year")))){%><option value="<%=s.get("id")%>"><%=HtmlUtil.escape(s.get("class_name"))%> · <%=HtmlUtil.escape(s.get("section_name"))%></option><%}}%></select></label><label class="text-xs">Initial password<input type="password" name="password" minlength="8" required class="mt-1 block w-full rounded border px-2 py-2"></label><button class="rounded bg-emerald-700 px-4 py-2 font-semibold text-white sm:col-span-3">Create student account</button></form></details><%}%></div><%}else{%><p class="text-sm text-emerald-700">Enrolled as student ID <%=a.get("converted_student_id")%>.</p><%}%></article><%}%><%if(applications==null||applications.isEmpty()){%><p class="rounded-xl bg-white p-8 text-center text-slate-500">No applications have been recorded.</p><%}%></div>
</section></main></div></body></html>
