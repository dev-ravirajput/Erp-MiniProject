<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %><%String pageTitle="Guardians";User currentUser=(User)session.getAttribute("user");String adminDisplayName=currentUser==null?"Administrator":currentUser.getName();String initial=adminDisplayName==null||adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();
List<Map<String,Object>> guardians=(List<Map<String,Object>>)request.getAttribute("guardians"),students=(List<Map<String,Object>>)request.getAttribute("studentOptions");
%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Guardians</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="space-y-5 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">Parent and guardian accounts</h2><p class="mt-1 text-sm text-slate-500">Link one account to multiple children for attendance, assignments, results, and fees.</p></div>
<%if(request.getAttribute("loadError")!=null){%><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}if(request.getAttribute("formError")!=null){%><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("formError"))%></p><%}if("created".equals(request.getParameter("notice"))){%><p class="rounded-lg bg-emerald-50 p-4 text-emerald-700">Parent account created.</p><%}%>
<div class="grid gap-6 xl:grid-cols-[1fr_24rem]"><div class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Parent</th><th class="px-4 py-3">Phone</th><th class="px-4 py-3">Children</th><th class="px-4 py-3">Status</th></tr></thead><tbody><%if(guardians!=null)for(Map<String,Object> g:guardians){%><tr class="border-t"><td class="px-4 py-3"><div class="font-semibold"><%=HtmlUtil.escape(g.get("name"))%></div><div class="text-xs text-slate-500"><%=HtmlUtil.escape(g.get("email"))%></div></td><td class="px-4 py-3"><%=HtmlUtil.escape(g.get("phone"))%></td><td class="px-4 py-3"><%=g.get("child_count")%></td><td class="px-4 py-3"><%=Integer.valueOf(1).equals(g.get("status"))?"Active":"Inactive"%></td></tr><%}%><%if(guardians==null||guardians.isEmpty()){%><tr><td colspan="4" class="p-8 text-center text-slate-500">No parent accounts yet.</td></tr><%}%></tbody></table></div>
<form method="post" class="space-y-3 rounded-xl bg-white p-5 shadow-sm"><h3 class="font-bold">Create parent account</h3><label class="block text-sm">Name<input name="name" maxlength="100" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="block text-sm">Email<input name="email" type="email" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="block text-sm">Initial password<input name="password" type="password" minlength="8" required class="mt-1 block w-full rounded border px-3 py-2"></label><label class="block text-sm">Phone<input name="phone" maxlength="20" class="mt-1 block w-full rounded border px-3 py-2"></label><label class="block text-sm">Relationship<input name="relationship_label" maxlength="40" placeholder="Parent, guardian" class="mt-1 block w-full rounded border px-3 py-2"></label><label class="block text-sm">Linked students<select name="student_ids" multiple required size="7" class="mt-1 block w-full rounded border px-3 py-2"><%if(students!=null)for(Map<String,Object> s:students){%><option value="<%=s.get("id")%>"><%=HtmlUtil.escape(s.get("name"))%> · <%=HtmlUtil.escape(s.get("admission_no"))%></option><%}%></select></label><button class="rounded bg-indigo-700 px-4 py-2 font-semibold text-white">Create account</button></form></div></section></main></div></body></html>
