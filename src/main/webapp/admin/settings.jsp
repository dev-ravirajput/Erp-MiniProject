<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.Map,com.erp.util.HtmlUtil,com.erp.model.User" %><%
Map<String,String> settings=(Map<String,String>)request.getAttribute("settings");String pageTitle="Website Settings";User sessionUser=(User)session.getAttribute("user");String adminDisplayName=sessionUser!=null&&sessionUser.getName()!=null?sessionUser.getName():"Administrator";String initial=adminDisplayName.isEmpty()?"A":adminDisplayName.substring(0,1).toUpperCase();boolean saved="updated".equals(request.getParameter("notice"));%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Website Settings</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 font-sans text-slate-800"><div class="min-h-screen lg:flex"><%@include file="admin-nav.jspf"%><main class="min-w-0 flex-1 lg:ml-60"><%@include file="admin-header.jspf"%><section class="p-4 sm:p-6 lg:p-8"><div class="mb-5"><h2 class="text-2xl font-bold">Website identity</h2><p class="mt-1 text-sm text-slate-500">Set the site name, logo, and favicon used across the application.</p></div>
<%if(saved){%><div class="mb-5 max-w-3xl border-l-4 border-emerald-500 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Website settings saved.</div><%}%><%if(request.getAttribute("loadError")!=null){%><div class="mb-5 max-w-3xl border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-800"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></div><%}%><%if(request.getAttribute("formError")!=null){%><div class="mb-5 max-w-3xl border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-800"><%=HtmlUtil.escape(request.getAttribute("formError"))%></div><%}%>
<form method="post" enctype="multipart/form-data" action="<%=request.getContextPath()%>/admin/settings" class="max-w-3xl border border-slate-200 bg-white shadow-sm"><div class="space-y-5 p-5 sm:p-7">
<div><label for="site_name" class="mb-1.5 block text-sm font-semibold text-slate-700">Website name *</label><input id="site_name" name="site_name" required maxlength="100" value="<%=HtmlUtil.escape(settings.get("site_name"))%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"><p class="mt-1 text-xs text-slate-500">Shown in the sidebar brand and browser page title.</p></div>
<div><label for="logo_file" class="mb-1.5 block text-sm font-semibold text-slate-700">Logo image</label><input id="logo_file" name="logo_file" type="file" accept="image/png,image/jpeg,image/gif" data-current-src="<%=HtmlUtil.escape(settings.get("logo_url"))%>" data-app-context="<%=request.getContextPath()%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"><p class="mt-1 text-xs text-slate-500">PNG, JPEG, or GIF, up to 5 MB. Leave empty to keep the current logo.</p><div class="mt-3 flex h-16 items-center gap-3 rounded-md bg-slate-900 px-4 text-white"><img id="logo-preview" class="hidden h-10 w-10 rounded bg-white object-contain" alt="Logo preview"><span id="logo-fallback" class="flex h-9 w-9 items-center justify-center rounded bg-indigo-600 font-bold">E</span><span id="name-preview" class="font-semibold">EduERP</span></div></div>
<div><label for="favicon_file" class="mb-1.5 block text-sm font-semibold text-slate-700">Favicon image</label><input id="favicon_file" name="favicon_file" type="file" accept="image/png,image/jpeg,image/gif" data-current-src="<%=HtmlUtil.escape(settings.get("favicon_url"))%>" data-app-context="<%=request.getContextPath()%>" class="w-full rounded-md border border-slate-300 px-3 py-2.5 text-sm"><p class="mt-1 text-xs text-slate-500">PNG, JPEG, or GIF, up to 5 MB. Leave empty to keep the current favicon.</p><img id="favicon-preview" class="mt-3 h-10 w-10 rounded border object-contain" alt="Favicon preview"></div>
</div><div class="flex justify-end border-t border-slate-200 bg-slate-50 px-5 py-4 sm:px-7"><button class="rounded-md bg-indigo-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-800"><i class="fa-solid fa-check mr-1"></i>Save settings</button></div></form>
<div class="mt-5 max-w-3xl border border-slate-200 bg-white p-5 text-sm text-slate-600"><h3 class="font-semibold text-slate-900">Storage format</h3><p class="mt-1">Values are saved in <code class="rounded bg-slate-100 px-1">app_settings</code> as key/value rows: <code>site_name</code>, <code>logo_url</code>, and <code>favicon_url</code>.</p></div>
</section></main></div><script>
const siteNameInput=document.getElementById('site_name'),logoInput=document.getElementById('logo_file'),logoPreview=document.getElementById('logo-preview'),fallback=document.getElementById('logo-fallback');
function src(input){return input.dataset.currentSrc?(input.dataset.currentSrc.startsWith('/')?input.dataset.appContext+input.dataset.currentSrc:input.dataset.currentSrc):''}function updateBrandPreview(){document.getElementById('name-preview').textContent=siteNameInput.value||'EduERP';fallback.textContent=(siteNameInput.value||'E').charAt(0).toUpperCase();const file=logoInput.files[0];logoPreview.src=file?URL.createObjectURL(file):src(logoInput);if(logoPreview.src){logoPreview.classList.remove('hidden');fallback.classList.add('hidden');}else{logoPreview.classList.add('hidden');fallback.classList.remove('hidden');}}
siteNameInput.addEventListener('input',updateBrandPreview);logoInput.addEventListener('change',updateBrandPreview);const faviconInput=document.getElementById('favicon_file'),faviconPreview=document.getElementById('favicon-preview');faviconPreview.src=src(faviconInput);faviconInput.addEventListener('change',()=>{if(faviconInput.files[0])faviconPreview.src=URL.createObjectURL(faviconInput.files[0]);});updateBrandPreview();
</script></body></html>
