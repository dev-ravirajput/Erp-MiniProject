<%@ page contentType="text/html;charset=UTF-8" import="java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("teacherProfile")==null){response.sendRedirect(request.getContextPath()+"/teacher/profile");return;}request.setAttribute("teacherPage","profile");Map<String,Object> t=(Map<String,Object>)request.getAttribute("teacherProfile");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Profile</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="teacher-nav.jspf"%><section class="p-4 sm:p-8"><h2 class="text-2xl font-bold">My profile</h2><p class="mb-6 mt-1 text-sm text-slate-500">Your account and employment details.</p><%if(request.getAttribute("loadError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><div class="max-w-3xl rounded-xl bg-white p-6 shadow-sm"><dl class="grid gap-5 sm:grid-cols-2"><%String[][] fields={{"Name","name"},{"Email","email"},{"Employee code","employee_code"},{"Phone","phone"},{"Department","department"},{"Qualification","qualification"},{"Joining date","joining_date"}};for(String[] f:fields){Object v=t.get(f[1]);%><div><dt class="text-xs font-semibold uppercase text-slate-400"><%=f[0]%></dt><dd class="mt-1 font-medium"><%=HtmlUtil.escape(v==null||v.toString().isBlank()?"Not provided":v)%></dd></div><%}%></dl><p class="mt-6 border-t pt-4 text-sm text-slate-500">For changes to your account details, contact your administrator.</p></div></section></main></div></body></html>
