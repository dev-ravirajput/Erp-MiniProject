<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("teacherProfile")==null){response.sendRedirect(request.getContextPath()+"/teacher/classes");return;}request.setAttribute("teacherPage","classes");List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("teachingAssignments");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My classes and subjects</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="teacher-nav.jspf"%><section class="p-4 sm:p-8"><h2 class="text-2xl font-bold">My classes &amp; subjects</h2><p class="mb-6 mt-1 text-sm text-slate-500">Classes and subjects assigned to you by the administrator.</p><%if(request.getAttribute("loadError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><div class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">Class</th><th class="px-5 py-3">Section</th><th class="px-5 py-3">Subject</th><th class="px-5 py-3">Academic year</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object> row:rows){%><tr class="border-t"><td class="px-5 py-3 font-medium"><%=HtmlUtil.escape(row.get("class_name"))%></td><td class="px-5 py-3"><%=HtmlUtil.escape(row.get("section_name"))%></td><td class="px-5 py-3"><%=HtmlUtil.escape(row.get("subject_name"))%> <span class="text-xs text-slate-400"><%=HtmlUtil.escape(row.get("subject_code"))%></span></td><td class="px-5 py-3"><%=HtmlUtil.escape(row.get("academic_year"))%></td></tr><%}%><%if(rows==null||rows.isEmpty()){%><tr><td colspan="4" class="px-5 py-10 text-center text-slate-500">No teaching assignments found.</td></tr><%}%></tbody></table></div></section></main></div></body></html>
