<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("teacherProfile")==null){response.sendRedirect(request.getContextPath()+"/teacher/assignments");return;}request.setAttribute("teacherPage","assignments");List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("assignments"),teaching=(List<Map<String,Object>>)request.getAttribute("teachingAssignments");Map<String,Object> edit=(Map<String,Object>)request.getAttribute("assignmentForm");List<Map<String,Object>> submissions=(List<Map<String,Object>>)request.getAttribute("submissions");Object submissionsFor=request.getAttribute("submissionsFor");boolean editing=edit!=null&&edit.get("id")!=null;%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Assignments</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="teacher-nav.jspf"%><section class="space-y-6 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">Assignments</h2><p class="mt-1 text-sm text-slate-500">Create and manage work for your assigned classes.</p></div><%if(request.getAttribute("loadError")!=null){%><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}if(request.getAttribute("formError")!=null){%><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("formError"))%></p><%}if("saved".equals(request.getParameter("notice"))||"deleted".equals(request.getParameter("notice"))){%><p class="rounded-lg bg-emerald-50 p-4 text-emerald-700">Assignment updated.</p><%}%><div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(20rem,0.8fr)]"><section class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Assignment</th><th class="px-4 py-3">Class / subject</th><th class="px-4 py-3">Due</th><th class="px-4 py-3">Actions</th></tr></thead><tbody><%if(rows!=null)for(Map<String,Object> a:rows){boolean assignmentActive=Boolean.TRUE.equals(a.get("status"))||(a.get("status") instanceof Number&&((Number)a.get("status")).intValue()!=0);%><tr class="border-t"><td class="px-4 py-3 font-medium"><%=HtmlUtil.escape(a.get("title"))%><%if(!assignmentActive){%><span class="ml-1 text-xs text-slate-400">Inactive</span><%}%></td><td class="px-4 py-3"><%=HtmlUtil.escape(a.get("class_name"))%>  /  <%=HtmlUtil.escape(a.get("section_name"))%><div class="text-xs text-slate-500"><%=HtmlUtil.escape(a.get("subject_name"))%></div></td><td class="px-4 py-3"><%=HtmlUtil.escape(a.get("due_date"))%></td><td class="px-4 py-3"><div class="flex gap-2"><a class="rounded border px-2 py-1 text-indigo-700" href="?action=edit&amp;id=<%=a.get("id")%>">Edit</a><a class="rounded border px-2 py-1 text-emerald-700" href="?submissions_for=<%=a.get("id")%>">Submissions</a><%if(assignmentActive){%><form method="post" onsubmit="return confirm('Deactivate this assignment?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=a.get("id")%>"><button class="rounded border border-rose-200 px-2 py-1 text-rose-700">Deactivate</button></form><%}%></div></td></tr><%}%><%if(rows==null||rows.isEmpty()){%><tr><td colspan="4" class="px-4 py-8 text-center text-slate-500">No assignments created yet.</td></tr><%}%></tbody></table></section><form method="post" class="space-y-4 rounded-xl bg-white p-5 shadow-sm"><h3 class="font-bold"><%=editing?"Edit assignment":"Create assignment"%></h3><input type="hidden" name="action" value="<%=editing?"update":"create"%>"><%if(editing){%><input type="hidden" name="id" value="<%=edit.get("id")%>"><%}%><label class="block text-sm font-semibold">Class, section and subject<select name="assignment_id" required class="mt-1 block w-full rounded-md border px-3 py-2"><option value="">Choose teaching assignment</option><%for(Map<String,Object> a:teaching){%><option value="<%=a.get("id")%>" <%=edit!=null&&String.valueOf(edit.get("assignment_id")).equals(String.valueOf(a.get("id")))?"selected":""%>><%=HtmlUtil.escape(a.get("class_name"))%>  /  <%=HtmlUtil.escape(a.get("section_name"))%>  -  <%=HtmlUtil.escape(a.get("subject_name"))%> (<%=HtmlUtil.escape(a.get("academic_year"))%>)</option><%}%></select></label><label class="block text-sm font-semibold">Title<input name="title" maxlength="200" required value="<%=edit!=null?HtmlUtil.escape(edit.get("title")):""%>" class="mt-1 block w-full rounded-md border px-3 py-2"></label><label class="block text-sm font-semibold">Instructions<textarea name="description" rows="4" maxlength="10000" class="mt-1 block w-full rounded-md border px-3 py-2"><%=edit!=null&&edit.get("description")!=null?HtmlUtil.escape(edit.get("description")):""%></textarea></label><div class="grid gap-3 sm:grid-cols-2"><label class="block text-sm font-semibold">Assigned date<input type="date" name="assigned_date" required value="<%=edit!=null?edit.get("assigned_date"):java.time.LocalDate.now()%>" class="mt-1 block w-full rounded-md border px-3 py-2"></label><label class="block text-sm font-semibold">Due date<input type="date" name="due_date" required value="<%=edit!=null?edit.get("due_date"):""%>" class="mt-1 block w-full rounded-md border px-3 py-2"></label></div><div class="flex gap-2"><button class="rounded-md bg-indigo-700 px-4 py-2.5 font-semibold text-white"><%=editing?"Save changes":"Create assignment"%></button><%if(editing){%><a href="<%=request.getContextPath()%>/teacher/assignments" class="rounded-md border px-4 py-2.5">Cancel</a><%}%></div></form></div><%if(submissionsFor!=null){%><section class="space-y-4 rounded-xl bg-white p-5 shadow-sm"><div><h3 class="text-lg font-bold">Student submissions</h3><p class="text-sm text-slate-500">Review, grade, and leave feedback.</p></div><%if("graded".equals(request.getParameter("notice"))){%><p class="rounded bg-emerald-50 p-3 text-sm text-emerald-700">Feedback saved.</p><%}%><%if(submissions==null||submissions.isEmpty()){%><p class="rounded bg-slate-50 p-4 text-sm text-slate-500">No students have submitted work yet.</p><%}else for(Map<String,Object> sub:submissions){%><form method="post" class="grid gap-3 rounded-lg border border-slate-200 p-4 md:grid-cols-[1fr_10rem_1fr_auto]"><input type="hidden" name="action" value="grade_submission"><input type="hidden" name="assignment_id" value="<%=submissionsFor%>"><input type="hidden" name="submission_id" value="<%=sub.get("id")%>"><div><p class="font-semibold"><%=HtmlUtil.escape(sub.get("student_name"))%></p><p class="text-xs text-slate-500">Roll <%=HtmlUtil.escape(sub.get("roll_no"))%> · <%=HtmlUtil.escape(sub.get("submitted_at"))%><%=sub.get("submitted_late") instanceof Number&&((Number)sub.get("submitted_late")).intValue()==1?" · Late":""%></p><%if(sub.get("submission_text")!=null){%><p class="mt-2 whitespace-pre-line text-sm"><%=HtmlUtil.escape(sub.get("submission_text"))%></p><%}%><%if(sub.get("stored_filename")!=null){%><a class="mt-2 inline-block text-sm font-semibold text-indigo-700" href="<%=request.getContextPath()%>/assignment-files/<%=HtmlUtil.escape(sub.get("stored_filename"))%>">Download file: <%=HtmlUtil.escape(sub.get("original_filename"))%></a><%}%></div><label class="text-xs font-semibold">Grade / <%=HtmlUtil.escape(sub.get("max_grade"))%><input type="number" name="grade" min="0" max="<%=sub.get("max_grade")%>" step="0.01" value="<%=sub.get("grade")==null?"":sub.get("grade")%>" class="mt-1 block w-full rounded border px-3 py-2"></label><label class="text-xs font-semibold">Feedback<textarea name="feedback" maxlength="4000" rows="3" class="mt-1 block w-full rounded border px-3 py-2"><%=sub.get("feedback")==null?"":HtmlUtil.escape(sub.get("feedback"))%></textarea></label><button class="rounded bg-indigo-700 px-4 py-2 font-semibold text-white">Save</button></form><%}%></section><%}%></section></main></div></body></html>
