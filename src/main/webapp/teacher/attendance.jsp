<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("teacherProfile")==null){response.sendRedirect(request.getContextPath()+"/teacher/attendance");return;}request.setAttribute("teacherPage","attendance");List<Map<String,Object>> assignments=(List<Map<String,Object>>)request.getAttribute("teachingAssignments"),students=(List<Map<String,Object>>)request.getAttribute("attendanceRows");String assignmentId=(String)request.getAttribute("assignmentId"),date=(String)request.getAttribute("date"),sessionLabel=(String)request.getAttribute("sessionLabel");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Attendance</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="teacher-nav.jspf"%><section class="p-4 sm:p-8"><h2 class="text-2xl font-bold">Attendance</h2><p class="mb-6 mt-1 text-sm text-slate-500">Select one of your assigned classes and subjects, then record each student's status.</p><%if(request.getAttribute("loadError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}if(request.getAttribute("formError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("formError"))%></p><%}if("saved".equals(request.getParameter("notice"))){%><p class="mb-4 rounded-lg bg-emerald-50 p-4 text-emerald-700">Attendance saved.</p><%}%><form method="get" class="mb-5 flex flex-wrap items-end gap-3 rounded-xl bg-white p-4 shadow-sm"><label class="text-sm font-semibold">Class and subject<select name="assignment_id" onchange="this.form.submit()" class="mt-1 block min-w-64 rounded-md border px-3 py-2"><option value="">Choose assignment</option><%for(Map<String,Object> a:assignments){%><option value="<%=a.get("id")%>" <%=String.valueOf(a.get("id")).equals(assignmentId)?"selected":""%>><%=HtmlUtil.escape(a.get("class_name"))%> · <%=HtmlUtil.escape(a.get("section_name"))%> — <%=HtmlUtil.escape(a.get("subject_name"))%> (<%=HtmlUtil.escape(a.get("academic_year"))%>)</option><%}%></select></label><label class="text-sm font-semibold">Date<input type="date" name="date" value="<%=HtmlUtil.escape(date)%>" onchange="this.form.submit()" class="mt-1 block rounded-md border px-3 py-2"></label><label class="text-sm font-semibold">Session<input name="session_label" maxlength="40" value="<%=HtmlUtil.escape(sessionLabel)%>" class="mt-1 block rounded-md border px-3 py-2"></label><noscript><button class="rounded-md bg-indigo-700 px-4 py-2 text-white">Load roster</button></noscript></form>
<%if(assignmentId!=null&&!assignmentId.isEmpty()){%><form method="post" class="overflow-hidden rounded-xl bg-white shadow-sm"><input type="hidden" name="assignment_id" value="<%=HtmlUtil.escape(assignmentId)%>"><input type="hidden" name="date" value="<%=HtmlUtil.escape(date)%>"><input type="hidden" name="session_label" value="<%=HtmlUtil.escape(sessionLabel)%>"><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">Roll no.</th><th class="px-5 py-3">Student</th><th class="px-5 py-3">Status</th></tr></thead><tbody><%for(Map<String,Object> s:students){String old=String.valueOf(s.get("status"));%><tr class="border-t"><td class="px-5 py-3"><%=HtmlUtil.escape(s.get("roll_no")==null?"—":s.get("roll_no"))%></td><td class="px-5 py-3 font-medium"><%=HtmlUtil.escape(s.get("name"))%><input type="hidden" name="student_id" value="<%=s.get("student_id")%>"></td><td class="px-5 py-3"><select name="status" class="rounded-md border px-3 py-2"><%for(String option:new String[]{"PRESENT","ABSENT","LATE","LEAVE"}){%><option <%=option.equals(old)?"selected":""%>><%=option%></option><%}%></select></td></tr><%}%><%if(students.isEmpty()){%><tr><td colspan="3" class="px-5 py-8 text-center text-slate-500">No students are enrolled in this assignment's class.</td></tr><%}%></tbody></table></div><%if(!students.isEmpty()){%><div class="flex justify-end border-t p-4"><button class="rounded-md bg-indigo-700 px-5 py-2.5 font-semibold text-white">Save attendance</button></div><%}%></form><%}%></section></main></div></body></html>
