<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("teacherProfile")==null){response.sendRedirect(request.getContextPath()+"/teacher/students");return;}request.setAttribute("teacherPage","students");List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My students</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="teacher-nav.jspf"%><section class="space-y-5 p-4 sm:p-8"><div><h2 class="text-2xl font-bold">My students</h2><p class="mt-1 text-sm text-slate-500">Students enrolled in your assigned classes.</p></div><%if(request.getAttribute("loadError")!=null){%><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><div class="overflow-x-auto rounded-xl bg-white shadow-sm"><div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold">Student roster <span class="ml-1 text-sm font-normal text-slate-500">(<%=students==null?0:students.size()%>)</span></h3></div><table class="w-full min-w-[640px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">Roll no.</th><th class="px-5 py-3">Student</th><th class="px-5 py-3">Class / section</th><th class="px-5 py-3">Academic year</th></tr></thead><tbody><%if(students!=null)for(Map<String,Object> student:students){%><tr class="border-t border-slate-100"><td class="px-5 py-3"><%=HtmlUtil.escape(student.get("roll_no")==null?"—":student.get("roll_no"))%></td><td class="px-5 py-3"><div class="font-medium"><%=HtmlUtil.escape(student.get("name"))%></div><div class="text-xs text-slate-500"><%=HtmlUtil.escape(student.get("email"))%></div></td><td class="px-5 py-3"><%=HtmlUtil.escape(student.get("class_name"))%> / <%=HtmlUtil.escape(student.get("section_name"))%></td><td class="px-5 py-3"><%=HtmlUtil.escape(student.get("academic_year"))%></td></tr><%}%><%if(students==null||students.isEmpty()){%><tr><td colspan="4" class="px-5 py-10 text-center text-slate-500">No active students are enrolled in your assigned classes.</td></tr><%}%></tbody></table></div></section></main></div></body></html>
