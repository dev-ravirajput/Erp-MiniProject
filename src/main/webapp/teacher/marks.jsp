<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("teacherProfile")==null){response.sendRedirect(request.getContextPath()+"/teacher/marks");return;}request.setAttribute("teacherPage","marks");List<Map<String,Object>> exams=(List<Map<String,Object>>)request.getAttribute("exams"),students=(List<Map<String,Object>>)request.getAttribute("markRows");String examId=(String)request.getAttribute("examId");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Marks</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="teacher-nav.jspf"%><section class="p-4 sm:p-8"><h2 class="text-2xl font-bold">Marks</h2><p class="mb-6 mt-1 text-sm text-slate-500">Enter marks for exams associated with your teaching assignments.</p><%if(request.getAttribute("loadError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}if(request.getAttribute("formError")!=null){%><p class="mb-4 rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("formError"))%></p><%}if("saved".equals(request.getParameter("notice"))){%><p class="mb-4 rounded-lg bg-emerald-50 p-4 text-emerald-700">Marks saved.</p><%}%><%if("published".equals(request.getParameter("notice"))){%><p class="mb-4 rounded-lg bg-emerald-50 p-4 text-emerald-700">Results published to students.</p><%}if("unpublished".equals(request.getParameter("notice"))){%><p class="mb-4 rounded-lg bg-amber-50 p-4 text-amber-800">Results are hidden from students.</p><%}%><form method="get" class="mb-5 flex flex-wrap items-end gap-3 rounded-xl bg-white p-4 shadow-sm"><label class="text-sm font-semibold">Exam<select name="exam_id" onchange="this.form.submit()" class="mt-1 block min-w-72 rounded-md border px-3 py-2"><option value="">Choose exam</option><%for(Map<String,Object> e:exams){%><option value="<%=e.get("id")%>" <%=String.valueOf(e.get("id")).equals(examId)?"selected":""%>><%=HtmlUtil.escape(e.get("exam_name"))%> — <%=HtmlUtil.escape(e.get("class_name"))%> <%=HtmlUtil.escape(e.get("section_name"))%> · <%=HtmlUtil.escape(e.get("subject_name"))%> (<%=HtmlUtil.escape(e.get("exam_date"))%>)</option><%}%></select></label><noscript><button class="rounded-md bg-indigo-700 px-4 py-2 text-white">Load students</button></noscript></form><%if(examId!=null&&!examId.isEmpty()){%><form method="post" class="overflow-x-auto rounded-xl bg-white shadow-sm"><input type="hidden" name="exam_id" value="<%=HtmlUtil.escape(examId)%>"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">Roll no.</th><th class="px-5 py-3">Student</th><th class="px-5 py-3">Marks</th><th class="px-5 py-3">Remarks</th></tr></thead><tbody><%for(Map<String,Object> s:students){Object old=s.get("marks");%><tr class="border-t"><td class="px-5 py-3"><%=HtmlUtil.escape(s.get("roll_no")==null?"—":s.get("roll_no"))%></td><td class="px-5 py-3 font-medium"><%=HtmlUtil.escape(s.get("name"))%><input type="hidden" name="student_id" value="<%=s.get("student_id")%>"></td><td class="px-5 py-3"><input type="number" min="0" max="<%=s.get("max_marks")%>" step="0.01" name="marks" value="<%=old==null?"":HtmlUtil.escape(old)%>" class="w-32 rounded-md border px-3 py-2"><span class="ml-1 text-slate-400">/ <%=HtmlUtil.escape(s.get("max_marks"))%></span></td><td class="px-5 py-3"><input name="remarks" maxlength="255" value="<%=s.get("remarks")==null?"":HtmlUtil.escape(s.get("remarks"))%>" class="w-full min-w-40 rounded-md border px-3 py-2"></td></tr><%}%><%if(students.isEmpty()){%><tr><td colspan="4" class="px-5 py-8 text-center text-slate-500">No students are enrolled in this exam's assigned class.</td></tr><%}%></tbody></table><%if(!students.isEmpty()){%><div class="flex justify-end border-t p-4"><button class="rounded-md bg-indigo-700 px-5 py-2.5 font-semibold text-white">Save marks</button><button name="action" value="publish" class="rounded-md bg-emerald-700 px-5 py-2.5 font-semibold text-white">Publish results</button><button name="action" value="unpublish" class="rounded-md border border-amber-300 px-5 py-2.5 font-semibold text-amber-800">Hide results</button></div><%}%></form><%}%></section></main></div></body></html>
