<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%if(request.getAttribute("teacherProfile")==null){response.sendRedirect(request.getContextPath()+"/teacher/dashboard");return;}request.setAttribute("teacherPage","dashboard");Map<String,Object> teacher=(Map<String,Object>)request.getAttribute("teacherProfile");List<Map<String,Object>> classes=(List<Map<String,Object>>)request.getAttribute("classes"),assignments=(List<Map<String,Object>>)request.getAttribute("assignments"),exams=(List<Map<String,Object>>)request.getAttribute("exams");%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Teacher Dashboard</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-100 text-slate-800"><%@include file="teacher-nav.jspf"%><section class="p-4 sm:p-8"><%if(request.getAttribute("loadError")!=null){%><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%><div><p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">Teacher workspace</p><h2 class="mt-1 text-3xl font-bold">Welcome, <%=HtmlUtil.escape(teacher.get("name"))%></h2><p class="mt-2 text-slate-500">Manage your assigned classes, attendance, assignments, and marks.</p></div><div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><%String[][] stats={{"Assigned classes",String.valueOf(classes.size()),"fa-chalkboard"},{"Assignments",String.valueOf(assignments.size()),"fa-book-open"},{"Active exams",String.valueOf(exams.size()),"fa-file-lines"},{"Subjects",String.valueOf(((List<?>)request.getAttribute("teachingAssignments")).stream().map(a->((Map<?,?>)a).get("subject_id")).distinct().count()),"fa-book"}};for(String[] stat:stats){%><div class="rounded-xl bg-white p-5 shadow-sm"><i class="fa-solid <%=stat[2]%> text-indigo-600"></i><p class="mt-3 text-sm text-slate-500"><%=stat[0]%></p><p class="mt-1 text-2xl font-bold"><%=stat[1]%></p></div><%}%></div><div class="grid gap-6 xl:grid-cols-2"><section class="rounded-xl bg-white p-5 shadow-sm"><div class="mb-4 flex items-center justify-between"><h3 class="font-bold">My teaching assignments</h3><a class="text-sm font-semibold text-indigo-700" href="<%=request.getContextPath()%>/teacher/classes">View classes</a></div><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="text-xs uppercase text-slate-400"><tr><th class="py-2">Class</th><th>Subject</th><th>Year</th></tr></thead><tbody><%List<Map<String,Object>> teaching=(List<Map<String,Object>>)request.getAttribute("teachingAssignments");for(Map<String,Object> a:teaching){%><tr class="border-t"><td class="py-3"><%=HtmlUtil.escape(a.get("class_name"))%> · <%=HtmlUtil.escape(a.get("section_name"))%></td><td><%=HtmlUtil.escape(a.get("subject_name"))%></td><td><%=HtmlUtil.escape(a.get("academic_year"))%></td></tr><%}%><%if(teaching.isEmpty()){%><tr><td colspan="3" class="py-5 text-slate-500">No class or subject assignments are set up.</td></tr><%}%></tbody></table></div></section><section class="rounded-xl bg-white p-5 shadow-sm"><div class="mb-4 flex items-center justify-between"><h3 class="font-bold">Active exams</h3><a class="text-sm font-semibold text-indigo-700" href="<%=request.getContextPath()%>/teacher/marks">Enter marks</a></div><div class="space-y-3"><%for(Map<String,Object> e:exams){%><div class="rounded-lg border border-slate-100 p-3"><p class="font-semibold"><%=HtmlUtil.escape(e.get("exam_name"))%> · <%=HtmlUtil.escape(e.get("subject_name"))%></p><p class="mt-1 text-sm text-slate-500"><%=HtmlUtil.escape(e.get("exam_date"))%> · <%=HtmlUtil.escape(e.get("class_name"))%> <%=HtmlUtil.escape(e.get("section_name"))%></p></div><%}%><%if(exams.isEmpty()){%><p class="py-4 text-sm text-slate-500">No exams have been assigned to your classes.</p><%}%></div></section></main></div></body></html>
