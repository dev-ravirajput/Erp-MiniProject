<%@ page contentType="text/html;charset=UTF-8" import="java.util.List,java.util.Map,com.erp.util.HtmlUtil" %><%
List<Map<String,Object>> children=(List<Map<String,Object>>)request.getAttribute("children"),attendance=(List<Map<String,Object>>)request.getAttribute("attendance"),assignments=(List<Map<String,Object>>)request.getAttribute("assignments"),results=(List<Map<String,Object>>)request.getAttribute("results"),timetable=(List<Map<String,Object>>)request.getAttribute("timetable"),invoices=(List<Map<String,Object>>)request.getAttribute("invoices");Map<String,Object> child=(Map<String,Object>)request.getAttribute("selectedChild");
%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Family portal</title><script src="https://cdn.tailwindcss.com"></script></head><body class="min-h-screen bg-slate-100 text-slate-800"><header class="flex items-center justify-between bg-slate-900 px-5 py-4 text-white"><div><h1 class="text-lg font-bold">Family portal</h1><p class="text-xs text-slate-300">Signed in as <%=HtmlUtil.escape(((com.erp.model.User)session.getAttribute("user")).getName())%></p></div><form action="<%=request.getContextPath()%>/logout" method="post"><button class="rounded border border-slate-500 px-3 py-2 text-sm">Sign out</button></form></header><main class="mx-auto max-w-6xl space-y-6 p-4 sm:p-8">
<%if(request.getAttribute("loadError")!=null){%><p class="rounded-lg bg-rose-50 p-4 text-rose-700"><%=HtmlUtil.escape(request.getAttribute("loadError"))%></p><%}%>
<%if(children==null||children.isEmpty()){%><div class="rounded-xl bg-white p-8 text-center text-slate-600">No student profiles are linked to this account. Contact the school administrator.</div><%}else{%>
<form method="get" class="flex flex-wrap items-end gap-3 rounded-xl bg-white p-4 shadow-sm"><label class="text-sm font-semibold">Student<select name="student_id" onchange="this.form.submit()" class="mt-1 block min-w-64 rounded border px-3 py-2"><%for(Map<String,Object> c:children){%><option value="<%=c.get("student_id")%>" <%=String.valueOf(c.get("student_id")).equals(String.valueOf(child.get("student_id")))?"selected":""%>><%=HtmlUtil.escape(c.get("name"))%> · <%=HtmlUtil.escape(c.get("class_name"))%> <%=HtmlUtil.escape(c.get("section_name"))%></option><%}%></select></label><noscript><button class="rounded bg-indigo-700 px-4 py-2 text-white">View</button></noscript><div class="text-sm text-slate-500">Admission <%=HtmlUtil.escape(child.get("admission_no"))%> · Year <%=HtmlUtil.escape(child.get("academic_year"))%></div></form>
<div class="grid gap-6 lg:grid-cols-2"><section class="rounded-xl bg-white p-5 shadow-sm"><h2 class="mb-3 text-lg font-bold">Recent attendance</h2><div class="space-y-2"><%if(attendance!=null)for(Map<String,Object> a:attendance){%><div class="flex justify-between border-b py-2 text-sm"><span><%=HtmlUtil.escape(a.get("attendance_date"))%> · <%=HtmlUtil.escape(a.get("subject_name"))%></span><strong><%=HtmlUtil.escape(a.get("status"))%></strong></div><%}%><%if(attendance==null||attendance.isEmpty()){%><p class="text-sm text-slate-500">No attendance records.</p><%}%></div></section>
<section class="rounded-xl bg-white p-5 shadow-sm"><h2 class="mb-3 text-lg font-bold">Assignments</h2><div class="space-y-3"><%if(assignments!=null)for(Map<String,Object> a:assignments){%><div class="border-b pb-3"><p class="font-semibold"><%=HtmlUtil.escape(a.get("title"))%> <span class="text-xs font-normal text-slate-500">· <%=HtmlUtil.escape(a.get("subject_name"))%></span></p><p class="text-xs text-slate-500">Due <%=HtmlUtil.escape(a.get("due_date"))%> · <%=a.get("submitted_at")==null?"Not submitted":"Submitted "+HtmlUtil.escape(a.get("submitted_at"))+(a.get("submitted_late") instanceof Number&&((Number)a.get("submitted_late")).intValue()==1?" · Late":"")%></p><%if(a.get("grade")!=null){%><p class="text-sm">Grade: <%=HtmlUtil.escape(a.get("grade"))%></p><%}%><%if(a.get("feedback")!=null){%><p class="text-sm text-slate-600"><%=HtmlUtil.escape(a.get("feedback"))%></p><%}%></div><%}%><%if(assignments==null||assignments.isEmpty()){%><p class="text-sm text-slate-500">No assignments.</p><%}%></div></section>
<section class="rounded-xl bg-white p-5 shadow-sm"><h2 class="mb-3 text-lg font-bold">Published results</h2><div class="space-y-2"><%if(results!=null)for(Map<String,Object> r:results){%><div class="flex justify-between border-b py-2 text-sm"><span><%=HtmlUtil.escape(r.get("exam_name"))%> · <%=HtmlUtil.escape(r.get("subject_name"))%></span><strong><%=HtmlUtil.escape(r.get("marks"))%> / <%=HtmlUtil.escape(r.get("max_marks"))%> · <%=HtmlUtil.escape(r.get("grade"))%></strong></div><%}%><%if(results==null||results.isEmpty()){%><p class="text-sm text-slate-500">No published results.</p><%}%></div></section>
<section class="rounded-xl bg-white p-5 shadow-sm"><h2 class="mb-3 text-lg font-bold">Class timetable</h2><div class="space-y-2"><%if(timetable!=null)for(Map<String,Object> t:timetable){%><div class="flex justify-between border-b py-2 text-sm"><span><%=HtmlUtil.escape(t.get("day_of_week"))%> · <%=HtmlUtil.escape(t.get("start_time"))%>–<%=HtmlUtil.escape(t.get("end_time"))%> · <%=HtmlUtil.escape(t.get("subject_name"))%></span><span><%=HtmlUtil.escape(t.get("teacher_name"))%></span></div><%}%><%if(timetable==null||timetable.isEmpty()){%><p class="text-sm text-slate-500">No timetable entries.</p><%}%></div></section><section class="rounded-xl bg-white p-5 shadow-sm"><h2 class="mb-3 text-lg font-bold">Fees</h2><div class="space-y-2"><%if(invoices!=null)for(Map<String,Object> i:invoices){%><div class="flex justify-between border-b py-2 text-sm"><span><%=HtmlUtil.escape(i.get("title"))%> · due <%=HtmlUtil.escape(i.get("due_date"))%><%if(i.get("overdue") instanceof Number&&((Number)i.get("overdue")).intValue()==1){%><span class="ml-2 text-xs font-semibold text-rose-700">Overdue</span><%}%></span><strong>Balance <%=HtmlUtil.escape(i.get("balance"))%></strong></div><%}%><%if(invoices==null||invoices.isEmpty()){%><p class="text-sm text-slate-500">No invoices.</p><%}%></div></section></div><%}%></main></body></html>
